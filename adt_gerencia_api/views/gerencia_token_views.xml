<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sesiones de la app de gerencia: el administrador puede ver quién entró y revocar accesos. -->
    <record id="adt_gerencia_token_tree" model="ir.ui.view">
        <field name="name">adt.gerencia.token.tree</field>
        <field name="model">adt.gerencia.token</field>
        <field name="arch" type="xml">
            <tree string="Sesiones de la app de gerencia" create="0" decoration-muted="revocado">
                <field name="user_id"/>
                <field name="name"/>
                <field name="app_version" optional="show"/>
                <field name="create_date" string="Inicio de sesión"/>
                <field name="ultimo_uso"/>
                <field name="expira"/>
                <field name="ip" optional="hide"/>
                <field name="revocado"/>
                <button name="action_revocar" type="object" string="Revocar" icon="fa-ban"
                        attrs="{'invisible': [('revocado', '=', True)]}"/>
            </tree>
        </field>
    </record>

    <record id="adt_gerencia_token_search" model="ir.ui.view">
        <field name="name">adt.gerencia.token.search</field>
        <field name="model">adt.gerencia.token</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="name"/>
                <filter name="activas" string="Activas" domain="[('revocado', '=', False)]"/>
                <filter name="revocadas" string="Revocadas" domain="[('revocado', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adt_gerencia_token" model="ir.actions.act_window">
        <field name="name">Sesiones de la app de gerencia</field>
        <field name="res_model">adt.gerencia.token</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_activas': 1}</field>
    </record>

    <menuitem id="menu_adt_gerencia_token"
              name="Sesiones app de gerencia"
              parent="base.menu_users"
              action="action_adt_gerencia_token"
              groups="base.group_system"
              sequence="50"/>

</odoo>
