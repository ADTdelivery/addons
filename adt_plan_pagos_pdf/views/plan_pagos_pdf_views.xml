<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_plan_pagos_pdf_tree" model="ir.ui.view">
        <field name="name">adt.plan.pagos.pdf.tree</field>
        <field name="model">adt.plan.pagos.pdf</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'valido'" decoration-warning="state == 'observado'"
                  decoration-danger="state == 'error'">
                <field name="nro_solicitud"/>
                <field name="socio"/>
                <field name="dni"/>
                <field name="monto_credito"/>
                <field name="cuotas_pendientes"/>
                <field name="capital_pendiente"/>
                <field name="confianza"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_plan_pagos_pdf_form" model="ir.ui.view">
        <field name="name">adt.plan.pagos.pdf.form</field>
        <field name="model">adt.plan.pagos.pdf</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_procesar" string="Procesar PDF" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,valido,observado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" attrs="{'invisible': [('error', '=', False)]}">
                        <field name="error"/>
                    </div>
                    <group>
                        <group>
                            <field name="pdf_file" filename="pdf_filename"/>
                            <field name="pdf_filename" invisible="1"/>
                            <field name="socio"/>
                            <field name="dni"/>
                            <field name="nro_solicitud"/>
                            <field name="nro_expediente"/>
                        </group>
                        <group>
                            <field name="monto_credito"/>
                            <field name="tasa_interes_anual"/>
                            <field name="plazo_dias"/>
                            <field name="cuotas_pendientes"/>
                            <field name="capital_pendiente"/>
                            <field name="confianza"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Validaciones">
                            <field name="validacion_html" nolabel="1"/>
                        </page>
                        <page string="JSON">
                            <field name="json_data" nolabel="1" class="text-monospace"/>
                        </page>
                        <page string="Texto extraído">
                            <field name="texto" nolabel="1" class="text-monospace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_plan_pagos_pdf_search" model="ir.ui.view">
        <field name="name">adt.plan.pagos.pdf.search</field>
        <field name="model">adt.plan.pagos.pdf</field>
        <field name="arch" type="xml">
            <search>
                <field name="socio"/>
                <field name="dni"/>
                <field name="nro_solicitud"/>
                <field name="nro_expediente"/>
                <filter name="valido" string="Válidos" domain="[('state', '=', 'valido')]"/>
                <filter name="observado" string="Observados" domain="[('state', 'in', ('observado', 'error'))]"/>
            </search>
        </field>
    </record>

    <record id="action_plan_pagos_pdf" model="ir.actions.act_window">
        <field name="name">Planes de Pago (PDF)</field>
        <field name="res_model">adt.plan.pagos.pdf</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_plan_pagos_pdf_root" name="Plan de Pagos PDF" sequence="95"/>
    <menuitem id="menu_plan_pagos_pdf" name="Planes de Pago" parent="menu_plan_pagos_pdf_root"
              action="action_plan_pagos_pdf" sequence="10"/>

</odoo>
