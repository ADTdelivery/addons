<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Reutiliza la base visual de los otros dashboards (adt_fin, adt_cob) y agrega lo propio (adt_cli). -->
    <t t-name="adt_comercial.ClientesDashboard">
        <div class="o_action adt_fin adt_cob adt_cli">
            <div class="adt_fin__scroll">
                <header class="adt_fin__header">
                    <div>
                        <h1 class="adt_fin__title">Clientes: recompra y riesgo</h1>
                        <p class="adt_fin__subtitle" data-ref="subtitle"/>
                    </div>
                    <div class="adt_fin__header-actions">
                        <button type="button" class="adt_fin__btn adt_fin__btn--ghost" data-action="seguimientos">Ver seguimientos</button>
                        <button type="button" class="adt_fin__btn" data-action="refresh">Actualizar</button>
                    </div>
                </header>
                <div class="adt_fin__filters">
                    <nav class="adt_fin__chips" data-ref="financieras" aria-label="Financiera"/>
                </div>
                <div data-ref="body">
                    <div class="adt_fin__empty">Analizando el historial de los clientes…</div>
                </div>
            </div>
            <div class="adt_cli__backdrop" data-action="cerrar"/>
            <aside class="adt_cli__panel" data-ref="panel" role="dialog" aria-modal="true" aria-label="Ficha del cliente"/>
            <div class="adt_fin__tooltip" data-ref="tooltip" role="tooltip"/>
        </div>
    </t>

</templates>
