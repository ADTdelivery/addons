<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Procesa por tandas los PDFs de las cargas masivas. "Procesar" lo dispara al momento;
             el intervalo es solo un respaldo si una tanda se cortó. -->
        <record id="ir_cron_carga_pdf_financiera" model="ir.cron">
            <field name="name">ADT Comercial: Carga masiva de planes de pago (PDF)</field>
            <field name="model_id" ref="adt_comercial.model_adt_financiera_carga_pdf"/>
            <field name="state">code</field>
            <field name="code">model._cron_procesar()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
