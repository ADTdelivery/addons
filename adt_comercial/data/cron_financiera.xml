<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Refresca cada día el estado con la financiera (depende de la fecha de hoy). -->
        <record id="ir_cron_actualizar_financiera" model="ir.cron">
            <field name="name">ADT Comercial: Actualizar estado de financieras</field>
            <field name="model_id" ref="adt_comercial.model_adt_comercial_cuentas"/>
            <field name="state">code</field>
            <field name="code">model._cron_actualizar_financiera()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall">2026-09-21 05:10:00</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
