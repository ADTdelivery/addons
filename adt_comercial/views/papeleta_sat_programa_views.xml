<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adt_papeleta_sat_programa_tree_financiera" model="ir.ui.view">
        <field name="name">adt.papeleta.sat.programa.tree.financiera</field>
        <field name="model">adt.papeleta.sat.programa</field>
        <field name="inherit_id" ref="adt_papeletas.view_adt_papeleta_sat_programa_tree"/>
        <field name="arch" type="xml">
            <field name="alcance" position="after">
                <field name="financiera_ids" widget="many2many_tags" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_adt_papeleta_sat_programa_form_financiera" model="ir.ui.view">
        <field name="name">adt.papeleta.sat.programa.form.financiera</field>
        <field name="model">adt.papeleta.sat.programa</field>
        <field name="inherit_id" ref="adt_papeletas.view_adt_papeleta_sat_programa_form"/>
        <field name="arch" type="xml">
            <field name="estado_cuenta_ids" position="before">
                <field name="financiera_ids" widget="many2many_tags" options="{'no_create': True}"
                       attrs="{'invisible': [('alcance', '!=', 'financiera')],
                               'required': [('alcance', '=', 'financiera')]}"/>
            </field>
        </field>
    </record>
</odoo>
