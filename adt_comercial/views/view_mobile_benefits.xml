<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         Beneficios (GET /v1/beneficios — módulo "Beneficios" de la app)
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_benefit_tree" model="ir.ui.view">
        <field name="name">mobile.benefit.tree</field>
        <field name="model">mobile.benefit</field>
        <field name="arch" type="xml">
            <tree string="Beneficios">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="categoria"/>
                <field name="titulo"/>
                <field name="proveedor_nombre"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_benefit_form" model="ir.ui.view">
        <field name="name">mobile.benefit.form</field>
        <field name="model">mobile.benefit</field>
        <field name="arch" type="xml">
            <form string="Beneficio">
                <sheet>
                    <field name="imagen_card" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="titulo" placeholder="Título"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="categoria"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="proveedor_nombre"/>
                            <field name="proveedor_logo" widget="image"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="descripcion_corta" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Multimedia">
                            <field name="media_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="tipo"/>
                                    <field name="archivo" filename="archivo_filename" widget="binary"/>
                                    <field name="archivo_filename" invisible="1"/>
                                    <field name="url"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Staff">
                            <field name="staff_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="nombre"/>
                                    <field name="especialidad"/>
                                    <field name="whatsapp"/>
                                    <field name="avatar" widget="image" options="{'size': [40, 40]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Cobertura (qué cubre)">
                            <field name="cobertura_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="icono"/>
                                    <field name="texto"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Recomendaciones">
                            <field name="recomendacion_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="icono"/>
                                    <field name="titulo"/>
                                    <field name="texto"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_benefit" model="ir.actions.act_window">
        <field name="name">Beneficios</field>
        <field name="res_model">mobile.benefit</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- ═══════════════════════════════════════════════════════════════════
         Bloque "App" — organizado como la navegación real de la app móvil
         (Inicio de sesión / Mi vehículo / Tienda de repuestos / Novedades y
         Noticias / Banners Home / Notificaciones), en paralelo a los bloques
         técnicos (Configuración General, Clientes y Accesos, Contenido y
         Marketing, Técnico). Cada hoja de abajo reutiliza la MISMA acción ya
         definida en su bloque original — es solo otra puerta de entrada a lo
         mismo, no se duplica dato ni lógica, solo el acceso desde el menú.
    ═══════════════════════════════════════════════════════════════════ -->

    <menuitem id="menu_mobile_app"
              name="App"
              parent="menu_mobile_root"
              groups="group_access_adt_movil"
              sequence="10"/>

    <menuitem id="menu_mobile_app_login"
              name="Inicio de sesión"
              parent="menu_mobile_app"
              groups="group_access_adt_movil"
              sequence="10"/>
    <menuitem id="menu_mobile_app_login_images"
              name="Imágenes de la App"
              parent="menu_mobile_app_login"
              action="action_mobile_app_image"
              groups="group_access_adt_movil"
              sequence="10"/>

    <menuitem id="menu_mobile_app_vehiculo"
              name="Mi vehículo"
              parent="menu_mobile_app"
              groups="group_access_adt_movil"
              sequence="20"/>
    <menuitem id="menu_mobile_app_vehiculo_benefits"
              name="Beneficios"
              parent="menu_mobile_app_vehiculo"
              action="action_mobile_benefit"
              groups="group_access_adt_movil"
              sequence="10"/>
    <menuitem id="menu_mobile_app_vehiculo_payment"
              name="Cuenta de Pago"
              parent="menu_mobile_app_vehiculo"
              action="action_mobile_payment_account"
              groups="group_access_adt_movil"
              sequence="20"/>
    <menuitem id="menu_mobile_app_vehiculo_support"
              name="Contacto de Soporte"
              parent="menu_mobile_app_vehiculo"
              action="action_mobile_support_contact"
              groups="group_access_adt_movil"
              sequence="30"/>

    <menuitem id="menu_mobile_app_tienda"
              name="Tienda de repuestos"
              parent="menu_mobile_app"
              groups="group_access_adt_movil"
              sequence="30"/>
    <menuitem id="menu_mobile_app_tienda_productos"
              name="Productos"
              parent="menu_mobile_app_tienda"
              action="action_mobile_catalog_products"
              groups="group_access_adt_movil"
              sequence="10"/>
    <menuitem id="menu_mobile_app_tienda_cta"
              name="Botón comprar catálogo"
              parent="menu_mobile_app_tienda"
              action="action_mobile_catalog_cta_config_open_singleton"
              groups="group_access_adt_movil"
              sequence="20"/>

    <menuitem id="menu_mobile_app_noticias"
              name="Novedades y Noticias"
              parent="menu_mobile_app"
              groups="group_access_adt_movil"
              sequence="40"/>
    <menuitem id="menu_mobile_app_noticias_promos"
              name="Promociones"
              parent="menu_mobile_app_noticias"
              action="action_mobile_promotion"
              groups="group_access_adt_movil"
              sequence="10"/>

    <menuitem id="menu_mobile_app_banners"
              name="Banners Home"
              parent="menu_mobile_app"
              groups="group_access_adt_movil"
              sequence="50"/>
    <menuitem id="menu_mobile_app_banners_content"
              name="Banner Slide"
              parent="menu_mobile_app_banners"
              action="action_mobile_content_item"
              groups="group_access_adt_movil"
              sequence="10"/>
    <menuitem id="menu_mobile_app_banners_fullscreen"
              name="Publicidad Full Screen"
              parent="menu_mobile_app_banners"
              action="action_mobile_content_item_fullscreen"
              groups="group_access_adt_movil"
              sequence="20"/>

    <menuitem id="menu_mobile_app_notificaciones"
              name="Notificaciones"
              parent="menu_mobile_app"
              groups="group_access_adt_movil"
              sequence="60"/>
    <menuitem id="menu_mobile_app_notificaciones_masivas"
              name="Envío de notificaciones masivas"
              parent="menu_mobile_app_notificaciones"
              action="action_mobile_notificacion_masiva_wizard"
              groups="group_access_adt_movil"
              sequence="10"/>

</odoo>
