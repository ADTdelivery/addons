<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Seguimiento de clientes para un nuevo préstamo ── -->
    <record id="adt_cliente_seguimiento_tree" model="ir.ui.view">
        <field name="name">adt.cliente.seguimiento.tree</field>
        <field name="model">adt.cliente.seguimiento</field>
        <field name="arch" type="xml">
            <tree string="Seguimiento de clientes">
                <field name="partner_id"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'nuevo_prestamo'"
                       decoration-info="estado == 'interesado'"
                       decoration-muted="estado == 'no_interesado'"/>
                <field name="proximo_contacto"/>
                <field name="clasificacion_manual" widget="badge"
                       decoration-danger="clasificacion_manual == 'no_prestar'"
                       decoration-success="clasificacion_manual == 'apto'"
                       decoration-warning="clasificacion_manual == 'evaluar'"/>
                <field name="motivo_manual" optional="show"/>
                <field name="user_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="adt_cliente_seguimiento_form" model="ir.ui.view">
        <field name="name">adt.cliente.seguimiento.form</field>
        <field name="model">adt.cliente.seguimiento</field>
        <field name="arch" type="xml">
            <form string="Seguimiento del cliente">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="estado"/>
                            <field name="proximo_contacto"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="clasificacion_manual"/>
                            <field name="motivo_manual"
                                   attrs="{'required': [('clasificacion_manual', '=', 'no_prestar')]}"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Notas del seguimiento…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cliente_seguimiento" model="ir.actions.act_window">
        <field name="name">Seguimiento de clientes</field>
        <field name="res_model">adt.cliente.seguimiento</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ── Traspaso notarial de la moto al cliente ── -->
    <record id="adt_traspaso_notarial_tree" model="ir.ui.view">
        <field name="name">adt.traspaso.notarial.tree</field>
        <field name="model">adt.traspaso.notarial</field>
        <field name="arch" type="xml">
            <tree string="Traspasos notariales">
                <field name="cuenta_id"/>
                <field name="partner_id"/>
                <field name="vehiculo_id" optional="show"/>
                <field name="moto_placa" optional="show"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'completado'"
                       decoration-info="estado in ('en_notaria', 'en_registros')"
                       decoration-warning="estado == 'documentos'"
                       decoration-muted="estado == 'pendiente'"/>
                <field name="notaria" optional="show"/>
                <field name="fecha_firma" optional="show"/>
                <field name="fecha_completado" optional="show"/>
                <field name="user_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="adt_traspaso_notarial_form" model="ir.ui.view">
        <field name="name">adt.traspaso.notarial.form</field>
        <field name="model">adt.traspaso.notarial</field>
        <field name="arch" type="xml">
            <form string="Traspaso notarial">
                <header>
                    <field name="estado" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="cuenta_id"/>
                            <field name="partner_id"/>
                            <field name="vehiculo_id"/>
                            <field name="moto_placa"/>
                        </group>
                        <group>
                            <field name="notaria"/>
                            <field name="fecha_firma"/>
                            <field name="fecha_completado"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Documentos pendientes, costo de la notaría, observaciones…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="adt_traspaso_notarial_search" model="ir.ui.view">
        <field name="name">adt.traspaso.notarial.search</field>
        <field name="model">adt.traspaso.notarial</field>
        <field name="arch" type="xml">
            <search string="Traspasos notariales">
                <field name="partner_id"/>
                <field name="cuenta_id"/>
                <field name="moto_placa"/>
                <field name="notaria"/>
                <filter name="en_tramite" string="En trámite"
                        domain="[('estado', 'in', ('documentos', 'en_notaria', 'en_registros'))]"/>
                <filter name="completado" string="Completados" domain="[('estado', '=', 'completado')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_estado" string="Etapa" context="{'group_by': 'estado'}"/>
                    <filter name="group_notaria" string="Notaría" context="{'group_by': 'notaria'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_traspaso_notarial" model="ir.actions.act_window">
        <field name="name">Traspasos notariales</field>
        <field name="res_model">adt.traspaso.notarial</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ── Dashboard de Clientes (JS) ── -->
    <record id="action_dashboard_clientes" model="ir.actions.client">
        <field name="name">Dashboard de Clientes</field>
        <field name="tag">adt_clientes_dashboard</field>
    </record>

    <menuitem id="adt_comercial_menu_dashboard_clientes"
              name="Dashboard de Clientes"
              parent="adt_comercial_menu_dashboards"
              action="action_dashboard_clientes"
              sequence="5"
              groups="adt_comercial.group_access_adt_comercial,adt_comercial.group_access_adt_comercial_gerencia"/>

    <!-- ── Flota: candidatos a préstamo y traspaso notarial (JS, misma lógica del Dashboard de Clientes).
         adt_flota_360 los agrupa bajo su menú "Flota 360". ── -->
    <record id="action_candidatos_prestamo" model="ir.actions.client">
        <field name="name">Candidatos a préstamo</field>
        <field name="tag">adt_candidatos_prestamo</field>
    </record>

    <record id="action_traspaso_notarial_dashboard" model="ir.actions.client">
        <field name="name">Traspaso notarial</field>
        <field name="tag">adt_traspaso_notarial</field>
    </record>

    <menuitem id="menu_fleet_candidatos_prestamo"
              name="Candidatos a préstamo"
              parent="fleet.menu_root"
              action="action_candidatos_prestamo"
              sequence="5"
              groups="adt_comercial.group_access_adt_comercial,adt_comercial.group_access_adt_comercial_gerencia"/>

    <menuitem id="menu_fleet_traspaso_notarial"
              name="Traspaso notarial"
              parent="fleet.menu_root"
              action="action_traspaso_notarial_dashboard"
              sequence="6"
              groups="adt_comercial.group_access_adt_comercial,adt_comercial.group_access_adt_comercial_gerencia"/>
</odoo>
