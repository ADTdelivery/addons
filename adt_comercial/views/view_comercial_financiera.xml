<odoo>
    <record id="adt_comercial_financiera_tree" model="ir.ui.view">
        <field name="name">adt.comercial.financiera.tree</field>
        <field name="model">adt.comercial.financiera</field>
        <field name="arch" type="xml">
            <tree string="Tipos de Financiera" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="adt_comercial_financiera_form" model="ir.ui.view">
        <field name="name">adt.comercial.financiera.form</field>
        <field name="model">adt.comercial.financiera</field>
        <field name="arch" type="xml">
            <form string="Tipo de Financiera">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_comercial_financiera" model="ir.actions.act_window">
        <field name="name">Tipos de Financiera</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">adt.comercial.financiera</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="adt_comercial_menu_financieras"
              name="Tipos de Financiera"
              action="action_comercial_financiera"
              parent="menu_adt_comercial"
              sequence="90"/>
</odoo>

