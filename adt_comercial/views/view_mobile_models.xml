<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-001  App Version
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_app_version_tree" model="ir.ui.view">
        <field name="name">mobile.app.version.tree</field>
        <field name="model">mobile.app.version</field>
        <field name="arch" type="xml">
            <tree string="Versiones de la App">
                <field name="name"/>
                <field name="latest_version"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_app_version_form" model="ir.ui.view">
        <field name="name">mobile.app.version.form</field>
        <field name="model">mobile.app.version</field>
        <field name="arch" type="xml">
            <form string="Versión de la Aplicación Móvil">
                <sheet>
                    <group string="Información General">
                        <group>
                            <field name="name"/>
                            <field name="latest_version"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Mensajes">
                        <field name="update_message"/>
                    </group>
                    <group string="URLs de Tiendas">
                        <field name="store_url_android"/>
                        <field name="store_url_ios"/>
                    </group>
                    <notebook>
                        <page string="Historial de versiones anteriores">
                            <field name="history_ids" readonly="1">
                                <tree>
                                    <field name="version"/>
                                    <field name="changed_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_mobile_app_version" model="ir.actions.act_window">
        <field name="name">Versiones de la App</field>
        <field name="res_model">mobile.app.version</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_mobile_app_version_open_singleton" model="ir.actions.server">
        <field name="name">Abrir Versión de la App</field>
        <field name="model_id" ref="model_mobile_app_version"/>
        <field name="state">code</field>
        <field name="code">action = env['mobile.app.version'].action_open_singleton()</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-004  Promotions
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_promotion_tree" model="ir.ui.view">
        <field name="name">mobile.promotion.tree</field>
        <field name="model">mobile.promotion</field>
        <field name="arch" type="xml">
            <tree string="Promociones Móviles">
                <field name="name"/>
                <field name="title"/>
                <field name="link_type"/>
                <field name="active_from"/>
                <field name="active_to"/>
                <field name="priority"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_promotion_form" model="ir.ui.view">
        <field name="name">mobile.promotion.form</field>
        <field name="model">mobile.promotion</field>
        <field name="arch" type="xml">
            <form string="Promoción Móvil">
                <sheet>
                    <field name="image_url" invisible="1"/>
                    <group string="Información General">
                        <group>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="active_from"/>
                            <field name="active_to"/>
                        </group>
                    </group>
                    <group string="Imagen">
                        <field name="image" widget="image" nolabel="1"
                               options="{'size': [560, 315]}"/>
                    </group>
                    <group string="Enlace">
                        <field name="link_type"/>
                        <field name="deep_link" attrs="{'invisible': [('link_type', '!=', 'DEEP_LINK')]}"/>
                        <field name="external_url" attrs="{'invisible': [('link_type', '!=', 'EXTERNAL')]}"/>
                        <field name="external_url" attrs="{'invisible': [('link_type', '!=', 'WHATSAPP')]}"/>
                    </group>
                    <group string="Contenido">
                        <field name="body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_promotion" model="ir.actions.act_window">
        <field name="name">Promociones Móviles</field>
        <field name="res_model">mobile.promotion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-005  Notifications
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_notification_tree" model="ir.ui.view">
        <field name="name">mobile.notification.tree</field>
        <field name="model">mobile.notification</field>
        <field name="arch" type="xml">
            <tree string="Notificaciones Móviles">
                <field name="title"/>
                <field name="notification_type"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="is_read"/>
                <field name="created_at"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_notification_form" model="ir.ui.view">
        <field name="name">mobile.notification.form</field>
        <field name="model">mobile.notification</field>
        <field name="arch" type="xml">
            <form string="Notificación Móvil">
                <header>
                    <button name="mark_as_read" string="Marcar como Leído"
                            type="object" class="btn-primary"
                            attrs="{'invisible': [('is_read', '=', True)]}"/>
                </header>
                <sheet>
                    <group string="Información General">
                        <group>
                            <field name="title"/>
                            <field name="notification_type"/>
                            <field name="is_read"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="created_at"/>
                        </group>
                    </group>
                    <group string="Enlace">
                        <field name="link_type"/>
                        <field name="deep_link" attrs="{'invisible': [('link_type', '!=', 'DEEP_LINK')]}"/>
                        <field name="external_url" attrs="{'invisible': [('link_type', '!=', 'EXTERNAL')]}"/>
                    </group>
                    <group string="Contenido">
                        <field name="body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_notification" model="ir.actions.act_window">
        <field name="name">Notificaciones Móviles</field>
        <field name="res_model">mobile.notification</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-006  Mobile Tokens
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_token_tree" model="ir.ui.view">
        <field name="name">mobile.token.tree</field>
        <field name="model">mobile.token</field>
        <field name="arch" type="xml">
            <tree string="Tokens Móviles">
                <field name="token"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="revoked"/>
                <field name="expires_at"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_token_form" model="ir.ui.view">
        <field name="name">mobile.token.form</field>
        <field name="model">mobile.token</field>
        <field name="arch" type="xml">
            <form string="Token Móvil">
                <header>
                    <button name="revoke" string="Revocar Token"
                            type="object" class="btn-danger"
                            attrs="{'invisible': [('revoked', '=', True)]}"/>
                </header>
                <sheet>
                    <group string="Información General">
                        <group>
                            <field name="token"/>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="device_id"/>
                            <field name="device_model"/>
                            <field name="platform"/>
                            <field name="app_version"/>
                        </group>
                    </group>
                    <group string="Estado">
                        <field name="revoked"/>
                        <field name="revoked_at" attrs="{'invisible': [('revoked', '=', False)]}"/>
                        <field name="expires_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_token" model="ir.actions.act_window">
        <field name="name">Tokens Móviles</field>
        <field name="res_model">mobile.token</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Menu Items  (under a top-level "Móvil" menu)
    ═══════════════════════════════════════════════════════════════════ -->

    <menuitem id="menu_mobile_root"
              name="Móvil"
              groups="group_access_adt_movil"
              sequence="90"/>

    <!-- Bloques (sub-menús) del módulo Móvil, en este orden: App primero
         (para que al entrar al módulo se vea la vista previa de pantallas),
         luego Versión de la app, Clientes y Accesos y Técnico. -->

    <!-- Único contenido de este bloque: la versión de la app. Se deja como
         hoja directa (con acción propia) en vez de un sub-menú intermedio
         que solo contendría esa misma pantalla. -->
    <menuitem id="menu_mobile_config"
              name="Versión de la app"
              parent="menu_mobile_root"
              action="action_mobile_app_version_open_singleton"
              groups="group_access_adt_movil"
              sequence="20"/>

    <menuitem id="menu_mobile_customers"
              name="Clientes y Accesos"
              parent="menu_mobile_root"
              groups="group_access_adt_movil"
              sequence="30"/>

    <menuitem id="menu_mobile_technical"
              name="Técnico"
              parent="menu_mobile_root"
              groups="group_access_adt_movil"
              sequence="40"/>

    <menuitem id="menu_mobile_notifications"
              name="Notificaciones"
              parent="menu_mobile_technical"
              action="action_mobile_notification"
              groups="group_access_adt_movil"
              sequence="10"/>

    <menuitem id="menu_mobile_tokens"
              name="Tokens de Sesión"
              parent="menu_mobile_technical"
              action="action_mobile_token"
              groups="group_access_adt_movil"
              sequence="20"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-007  Payment Accounts (Cuentas de Pago)
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_payment_account_tree" model="ir.ui.view">
        <field name="name">mobile.payment.account.tree</field>
        <field name="model">mobile.payment.account</field>
        <field name="arch" type="xml">
            <tree string="Cuentas de Pago" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="account_number"/>
                <field name="icon_url"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_payment_account_form" model="ir.ui.view">
        <field name="name">mobile.payment.account.form</field>
        <field name="model">mobile.payment.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta de Pago Móvil">
                <sheet>
                    <group string="Información General">
                        <group>
                            <field name="name"/>
                            <field name="account_number"/>
                        </group>
                        <group>
                            <field name="icon_url"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_payment_account" model="ir.actions.act_window">
        <field name="name">Cuentas de Pago</field>
        <field name="res_model">mobile.payment.account</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-008  Support Contacts (Contactos de Soporte)
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_support_contact_tree" model="ir.ui.view">
        <field name="name">mobile.support.contact.tree</field>
        <field name="model">mobile.support.contact</field>
        <field name="arch" type="xml">
            <tree string="Contactos de Soporte" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="role"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_support_contact_form" model="ir.ui.view">
        <field name="name">mobile.support.contact.form</field>
        <field name="model">mobile.support.contact</field>
        <field name="arch" type="xml">
            <form string="Contacto de Soporte Móvil">
                <sheet>
                    <group string="Información General">
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="role"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_support_contact" model="ir.actions.act_window">
        <field name="name">Contactos de Soporte</field>
        <field name="res_model">mobile.support.contact</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-012  Global Catalog CTA Settings
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_catalog_cta_config_tree" model="ir.ui.view">
        <field name="name">mobile.catalog.cta.config.tree</field>
        <field name="model">mobile.catalog.cta.config</field>
        <field name="arch" type="xml">
            <tree string="Configuración botón comprar">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="cta_enabled"/>
                <field name="whatsapp_phone"/>
                <field name="whatsapp_url"/>
                <field name="button_text"/>
                <field name="button_color"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_catalog_cta_config_form" model="ir.ui.view">
        <field name="name">mobile.catalog.cta.config.form</field>
        <field name="model">mobile.catalog.cta.config</field>
        <field name="arch" type="xml">
            <form string="Configuración botón comprar catálogo">
                <sheet>
                    <group string="Diseño del botón en app móvil">
                        <group>
                            <field name="name"/>
                            <field name="button_text" placeholder="Comprar por WhatsApp"/>
                            <field name="button_color" placeholder="#25D366"/>
                            <field name="button_icon_image" filename="button_icon_image_filename" widget="image"/>
                            <field name="button_icon_image_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="cta_enabled"/>
                            <field name="whatsapp_phone" placeholder="51999111222"/>
                            <field name="whatsapp_url" placeholder="https://wa.me/51999111222?text=Hola"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Vista previa">
                        <field name="preview_html" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_catalog_cta_config" model="ir.actions.act_window">
        <field name="name">Botón comprar catálogo</field>
        <field name="res_model">mobile.catalog.cta.config</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mobile_catalog_cta_config_form"/>
    </record>

    <record id="action_mobile_catalog_cta_config_open_singleton" model="ir.actions.server">
        <field name="name">Abrir botón comprar catálogo</field>
        <field name="model_id" ref="model_mobile_catalog_cta_config"/>
        <field name="state">code</field>
        <field name="code">action = env['mobile.catalog.cta.config'].action_open_singleton()</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-013  Mobile App Image
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_app_image_tree" model="ir.ui.view">
        <field name="name">mobile.app.image.tree</field>
        <field name="model">mobile.app.image</field>
        <field name="arch" type="xml">
            <tree string="Imágenes de la App">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_app_image_form" model="ir.ui.view">
        <field name="name">mobile.app.image.form</field>
        <field name="model">mobile.app.image</field>
        <field name="arch" type="xml">
            <form string="Imagen de la Aplicación Móvil">
                <sheet>
                    <group string="Información General">
                        <group>
                            <field name="name"/>
                            <field name="code" placeholder="banner_home"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="image" filename="image_filename" widget="image"/>
                            <field name="image_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_app_image" model="ir.actions.act_window">
        <field name="name">Imágenes de la App</field>
        <field name="res_model">mobile.app.image</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-010  FCM Devices
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_fcm_device_tree" model="ir.ui.view">
        <field name="name">mobile.fcm.device.tree</field>
        <field name="model">mobile.fcm.device</field>
        <field name="arch" type="xml">
            <tree string="Dispositivos FCM">
                <field name="partner_id"/>
                <field name="platform"/>
                <field name="device_id"/>
                <field name="device_name"/>
                <field name="app_version"/>
                <field name="last_seen_at"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_fcm_device_form" model="ir.ui.view">
        <field name="name">mobile.fcm.device.form</field>
        <field name="model">mobile.fcm.device</field>
        <field name="arch" type="xml">
            <form string="Dispositivo FCM">
                <sheet>
                    <group string="Cliente y Sesion">
                        <group>
                            <field name="partner_id"/>
                            <field name="mobile_token_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="platform"/>
                            <field name="last_seen_at"/>
                        </group>
                    </group>
                    <group string="Dispositivo">
                        <group>
                            <field name="device_id"/>
                            <field name="device_name"/>
                        </group>
                        <group>
                            <field name="device_os"/>
                            <field name="app_version"/>
                        </group>
                    </group>
                    <group string="Token FCM">
                        <field name="fcm_token"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobile_fcm_device" model="ir.actions.act_window">
        <field name="name">Dispositivos FCM</field>
        <field name="res_model">mobile.fcm.device</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_mobile_fcm_devices"
              name="Dispositivos FCM"
              parent="menu_mobile_technical"
              action="action_mobile_fcm_device"
              groups="group_access_adt_movil"
              sequence="30"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         HU-014  Configurable Content Items
    ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mobile_content_item_tree" model="ir.ui.view">
        <field name="name">mobile.content.item.tree</field>
        <field name="model">mobile.content.item</field>
        <field name="arch" type="xml">
            <tree string="Items de Contenido">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="section"/>
                <field name="title"/>
                <field name="item_type"/>
                <field name="active_from"/>
                <field name="active_to"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_mobile_content_item_form" model="ir.ui.view">
        <field name="name">mobile.content.item.form</field>
        <field name="model">mobile.content.item</field>
        <field name="arch" type="xml">
            <form string="Item de Contenido Móvil">
                <sheet>
                    <field name="image_url" invisible="1"/>
                    <group string="Información General">
                        <group>
                            <field name="name"/>
                            <!-- Fijo según la pantalla desde la que se crea el
                                 registro (ver default_section en cada acción:
                                 action_mobile_content_item = BANNER_HOME,
                                 action_mobile_content_item_fullscreen =
                                 FULL_SCREEN) — no se deja editar para que no
                                 se pueda "escapar" de su sección. -->
                            <field name="section" readonly="1"/>
                            <field name="title"/>
                            <field name="subtitle"/>
                        </group>
                        <group>
                            <field name="icon" placeholder="whatsapp"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Vigencia (opcional)">
                        <field name="active_from"/>
                        <field name="active_to"/>
                    </group>
                    <group string="Imagen (opcional)">
                        <field name="image" widget="image" nolabel="1" options="{'size': [280, 280]}"/>
                    </group>
                    <group string="Acción">
                        <field name="item_type"/>
                        <field name="phone" placeholder="51999888777"
                               attrs="{'invisible': [('item_type', 'not in', ('PHONE', 'WHATSAPP'))]}"/>
                        <field name="link_url" placeholder="https://..."
                               attrs="{'invisible': [('item_type', '!=', 'LINK')]}"/>
                        <field name="deep_link" placeholder="app://seccion/detalle"
                               attrs="{'invisible': [('item_type', '!=', 'DEEP_LINK')]}"/>
                        <field name="button_label" placeholder="Ver más"/>
                        <field name="button_color" placeholder="#25D366"/>
                    </group>
                    <group string="Contenido">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Datos adicionales (JSON, opcional)">
                        <field name="extra_data" nolabel="1" placeholder='{"badge": "Nuevo"}'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- "Banner Slide": reusa mobile.content.item + el mismo servicio genérico
         GET /v1/content-items?section=<code> (HU-014, controllers/mobile_api.py),
         fijando la sección en BANNER_HOME. No se crea modelo/endpoint nuevo,
         solo esta puerta de entrada de Odoo con section fija y bloqueada. -->
    <record id="action_mobile_content_item" model="ir.actions.act_window">
        <field name="name">Banner Slide</field>
        <field name="res_model">mobile.content.item</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('section', '=', 'BANNER_HOME')]</field>
        <field name="context">{'default_section': 'BANNER_HOME'}</field>
    </record>

    <!-- "Publicidad Full Screen": mismo modelo y mismo servicio, sección
         FULL_SCREEN — otra opción dentro de "Banners Home", no una pantalla
         ni un modelo aparte. -->
