<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adt_mantenimiento_vehicle_report_status_tree" model="ir.ui.view">
        <field name="name">adt.mantenimiento.vehicle.report.status.tree</field>
        <field name="model">adt.mantenimiento.vehicle.report.status</field>
        <field name="arch" type="xml">
            <tree string="Estado de Reporte GPS" create="false">
                <field name="vehicle_id"/>
                <field name="ultima_fecha_reporte"/>
                <field name="dias_sin_reportar"
                       decoration-danger="dias_sin_reportar &gt;= 3"/>
                <field name="alerta_sin_reporte_enviada" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_adt_mantenimiento_vehicle_report_status_search" model="ir.ui.view">
        <field name="name">adt.mantenimiento.vehicle.report.status.search</field>
        <field name="model">adt.mantenimiento.vehicle.report.status</field>
        <field name="arch" type="xml">
            <search string="Estado de Reporte GPS">
                <field name="vehicle_id"/>
                <filter string="Alerta enviada (sin reportar)" name="filter_alerta"
                        domain="[('alerta_sin_reporte_enviada','=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_adt_mantenimiento_vehicle_report_status" model="ir.actions.act_window">
        <field name="name">Estado de Reporte GPS</field>
        <field name="res_model">adt.mantenimiento.vehicle.report.status</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
