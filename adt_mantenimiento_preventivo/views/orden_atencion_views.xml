<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Orígenes de atención (catálogo configurable) -->
    <record id="view_adt_mantenimiento_origen_atencion_tree" model="ir.ui.view">
        <field name="name">adt.mantenimiento.origen.atencion.tree</field>
        <field name="model">adt.mantenimiento.origen.atencion</field>
        <field name="arch" type="xml">
            <tree string="Orígenes de Atención" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_adt_mantenimiento_origen_atencion" model="ir.actions.act_window">
        <field name="name">Orígenes de Atención</field>
        <field name="res_model">adt.mantenimiento.origen.atencion</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura acá las opciones que verá el cliente en la app al
                indicar dónde se hizo el mantenimiento (ej. "ADT Taller",
                "Taller TVS", "Otro Taller"). Se pueden agregar, renombrar o
                desactivar sin tocar código.
            </p>
        </field>
    </record>

    <!-- Órdenes de atención (confirmaciones de mantenimiento realizado) -->
    <record id="view_adt_mantenimiento_orden_atencion_tree" model="ir.ui.view">
        <field name="name">adt.mantenimiento.orden.atencion.tree</field>
        <field name="model">adt.mantenimiento.orden.atencion</field>
        <field name="arch" type="xml">
            <tree string="Órdenes de Atención de Mantenimiento">
                <field name="fecha_atencion"/>
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <field name="regla_id"/>
                <field name="origen_id"/>
                <field name="km_atencion" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_adt_mantenimiento_orden_atencion_form" model="ir.ui.view">
        <field name="name">adt.mantenimiento.orden.atencion.form</field>
        <field name="model">adt.mantenimiento.orden.atencion</field>
        <field name="arch" type="xml">
            <form string="Orden de Atención de Mantenimiento">
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="regla_id"/>
                            <field name="umbral_id"/>
                            <field name="campana_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="origen_id"/>
                            <field name="fecha_atencion"/>
                            <field name="km_atencion"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="observaciones" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_adt_mantenimiento_orden_atencion_search" model="ir.ui.view">
        <field name="name">adt.mantenimiento.orden.atencion.search</field>
        <field name="model">adt.mantenimiento.orden.atencion</field>
        <field name="arch" type="xml">
            <search string="Órdenes de Atención de Mantenimiento">
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <field name="regla_id"/>
                <field name="origen_id"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Regla" name="groupby_regla" context="{'group_by': 'regla_id'}"/>
                    <filter string="Origen" name="groupby_origen" context="{'group_by': 'origen_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adt_mantenimiento_orden_atencion" model="ir.actions.act_window">
        <field name="name">Órdenes de Atención</field>
        <field name="res_model">adt.mantenimiento.orden.atencion</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Acá quedan registradas las confirmaciones de que un
                mantenimiento pendiente ya se realizó (por la app, o
                creadas manualmente). Al crear una, se cancela
                automáticamente la campaña de notificaciones activa de esa
                regla para ese vehículo.
            </p>
        </field>
    </record>

</odoo>
