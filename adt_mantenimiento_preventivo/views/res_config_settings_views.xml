<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_mantenimiento_preventivo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mantenimiento.preventivo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="companies" position="after">
                <h2>Mantenimiento Preventivo (Traccar)</h2>
                <div class="row mt16 o_settings_container" name="adt_mantenimiento_preventivo">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Alerta de vehículo sin reportar GPS</span>
                            <div class="text-muted">
                                Días sin reportar posición GPS a partir de los cuales se
                                publica una alerta en la ficha del vehículo.
                            </div>
                            <div class="content-group">
                                <div class="mt16 row">
                                    <label for="adt_mantenimiento_dias_sin_reporte" class="col-3 o_light_label"/>
                                    <field name="adt_mantenimiento_dias_sin_reporte" class="col-2"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Ventana horaria por defecto</span>
                            <div class="text-muted">
                                Usada para repartir uniformemente las notificaciones del día
                                cuando una regla no define "Horarios sugeridos" (o define menos
                                horarios de los necesarios). Formato HH:MM, hora Lima.
                            </div>
                            <div class="content-group">
                                <div class="mt16 row">
                                    <label for="adt_mantenimiento_horario_ventana_inicio" string="Inicio" class="col-3 o_light_label"/>
                                    <field name="adt_mantenimiento_horario_ventana_inicio" class="col-2"/>
                                </div>
                                <div class="mt8 row">
                                    <label for="adt_mantenimiento_horario_ventana_fin" string="Fin" class="col-3 o_light_label"/>
                                    <field name="adt_mantenimiento_horario_ventana_fin" class="col-2"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
