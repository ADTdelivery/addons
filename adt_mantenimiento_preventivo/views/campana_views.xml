<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adt_mantenimiento_campana_tree" model="ir.ui.view">
        <field name="name">adt.mantenimiento.campana.tree</field>
        <field name="model">adt.mantenimiento.campana</field>
        <field name="arch" type="xml">
            <tree string="Campañas de Notificación" create="false">
                <field name="vehicle_id"/>
                <field name="regla_id"/>
                <field name="partner_id"/>
                <field name="fecha_inicio"/>
                <field name="dia_actual"/>
                <field name="dias_totales"/>
                <field name="notificaciones_por_dia"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'activa'"
                       decoration-info="estado == 'finalizada'"
                       decoration-muted="estado == 'cancelada'"/>
            </tree>
        </field>
    </record>

    <record id="view_adt_mantenimiento_campana_form" model="ir.ui.view">
        <field name="name">adt.mantenimiento.campana.form</field>
        <field name="model">adt.mantenimiento.campana</field>
        <field name="arch" type="xml">
            <form string="Campaña de Notificación">
                <header>
                    <button name="action_test_envio" type="object" string="Probar envío ahora"
                            class="oe_highlight" attrs="{'invisible': [('estado', '!=', 'activa')]}"/>
                    <button name="action_cancelar" type="object" string="Cancelar campaña"
                            confirm="¿Confirma cancelar esta campaña? (ej. porque el mantenimiento ya fue realizado)"
                            attrs="{'invisible': [('estado', '!=', 'activa')]}"/>
                    <field name="estado" widget="statusbar" statusbar_visible="activa,finalizada"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_bitacora" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Envíos"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="regla_id" readonly="1"/>
                            <field name="umbral_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="fecha_inicio" readonly="1"/>
                            <field name="km_al_disparo" readonly="1"/>
                            <field name="dia_actual"/>
                            <field name="dias_totales"/>
                            <field name="notificaciones_por_dia"/>
                            <field name="notificaciones_enviadas_hoy"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bitácora de envíos" name="bitacora">
                            <field name="log_ids">
                                <tree>
                                    <field name="fecha_hora"/>
                                    <field name="partner_id"/>
                                    <field name="resultado" widget="badge"
                                           decoration-success="resultado == 'exito'"
                                           decoration-danger="resultado == 'error'"/>
                                    <field name="detalle"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_adt_mantenimiento_campana_search" model="ir.ui.view">
        <field name="name">adt.mantenimiento.campana.search</field>
        <field name="model">adt.mantenimiento.campana</field>
        <field name="arch" type="xml">
            <search string="Campañas de Notificación">
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <field name="regla_id"/>
                <filter string="Activas" name="filter_activa" domain="[('estado','=','activa')]"/>
                <filter string="Finalizadas" name="filter_finalizada" domain="[('estado','=','finalizada')]"/>
                <filter string="Canceladas" name="filter_cancelada" domain="[('estado','=','cancelada')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Regla" name="groupby_regla" context="{'group_by': 'regla_id'}"/>
                    <filter string="Estado" name="groupby_estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adt_mantenimiento_campana" model="ir.actions.act_window">
        <field name="name">Campañas de Notificación</field>
        <field name="res_model">adt.mantenimiento.campana</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_activa': 1}</field>
    </record>

    <record id="view_adt_mantenimiento_notificacion_log_tree" model="ir.ui.view">
        <field name="name">adt.mantenimiento.notificacion.log.tree</field>
        <field name="model">adt.mantenimiento.notificacion.log</field>
        <field name="arch" type="xml">
            <tree string="Bitácora de Notificaciones" create="false">
                <field name="fecha_hora"/>
                <field name="vehicle_id"/>
                <field name="regla_id"/>
                <field name="partner_id"/>
                <field name="resultado" widget="badge"
                       decoration-success="resultado == 'exito'"
                       decoration-danger="resultado == 'error'"/>
                <field name="detalle"/>
            </tree>
        </field>
    </record>

    <record id="action_adt_mantenimiento_notificacion_log" model="ir.actions.act_window">
        <field name="name">Bitácora de Notificaciones</field>
        <field name="res_model">adt.mantenimiento.notificacion.log</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
