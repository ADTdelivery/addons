<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_financiamiento" model="ir.module.category">
        <field name="name">Financiamiento</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_financiamiento_manager" model="res.groups">
        <field name="name">Administrador de financiamiento</field>
        <field name="category_id" ref="module_category_financiamiento"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_financiamiento_manager'))]"/>
    </record>
</odoo>
