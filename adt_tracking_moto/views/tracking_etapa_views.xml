<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="adt_moto_tracking_etapa_view_tree" model="ir.ui.view">
        <field name="name">adt.moto.tracking.etapa.tree</field>
        <field name="model">adt.moto.tracking.etapa</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="false" delete="false">
                <field name="sequence" readonly="1"/>
                <field name="codigo" readonly="1"/>
                <field name="name"/>
                <field name="sla_horas"/>
                <field name="descripcion"/>
            </tree>
        </field>
    </record>

    <record id="action_adt_moto_tracking_etapa" model="ir.actions.act_window">
        <field name="name">Etapas del tracking</field>
        <field name="res_model">adt.moto.tracking.etapa</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p>Las 4 etapas son fijas. Solo puede cambiar su nombre, descripción y SLA.</p>
        </field>
    </record>

</odoo>
