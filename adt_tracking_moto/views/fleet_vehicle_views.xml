<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_view_form_adt_tracking" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.adt.tracking</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="adt_tracking_id" invisible="1"/>
                <button name="action_ver_adt_tracking" type="object" class="oe_stat_button" icon="fa-road"
                        groups="adt_tracking_moto.group_tracking_user"
                        attrs="{'invisible': [('adt_tracking_id', '=', False)]}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tracking</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
