<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="adt_moto_tracking_taller_view_tree" model="ir.ui.view">
        <field name="name">adt.moto.tracking.taller.tree</field>
        <field name="model">adt.moto.tracking.taller</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="codigo"/>
                <field name="partner_id"/>
                <field name="direccion"/>
                <field name="sla_horas"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="adt_moto_tracking_taller_view_search" model="ir.ui.view">
        <field name="name">adt.moto.tracking.taller.search</field>
        <field name="model">adt.moto.tracking.taller</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="archivados" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_adt_moto_tracking_taller" model="ir.actions.act_window">
        <field name="name">Talleres de fibra</field>
        <field name="res_model">adt.moto.tracking.taller</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Agregue un taller o proveedor de fibra</p>
        </field>
    </record>

</odoo>
