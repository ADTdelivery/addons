<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_tracking_moto" model="ir.module.category">
        <field name="name">Operación de motos</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_tracking_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_tracking_moto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tracking_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_tracking_moto"/>
        <field name="implied_ids" eval="[(4, ref('group_tracking_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
