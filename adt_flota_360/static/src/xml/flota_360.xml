<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="adt_flota_360.Main">
        <div class="o_action adt_f360">
            <div class="adt_f360__scroll" data-ref="scroll">
                <header class="adt_f360__top">
                    <div class="adt_f360__headline">
                        <h1 class="adt_f360__title">Flota 360</h1>
                        <div class="adt_f360__search is-hero">
                            <i class="fa fa-search adt_f360__search-icon" aria-hidden="true"/>
                            <input type="search" class="adt_f360__search-input" data-ref="q" autocomplete="off"
                                   aria-label="Buscar vehículo"
                                   placeholder="Buscar por placa, DNI/RUC, nombre, chasis, motor, teléfono o N° de cuenta"/>
                            <button type="button" class="adt_f360__search-clear" data-action="clear" title="Limpiar" aria-label="Limpiar búsqueda">
                                <i class="fa fa-times"/>
                            </button>
                            <kbd class="adt_f360__kbd" title="Atajo de teclado: pulsa / para buscar">/</kbd>
                        </div>
                        <!-- Vehículos (clientes / stock), financiera, cronograma y clientes: en un popup para liberar espacio. -->
                        <div class="adt_f360__fpop-wrap" data-ref="fpop-wrap">
                            <button type="button" class="adt_f360__fpop-btn" data-action="filtros-abrir"
                                    aria-haspopup="dialog" aria-expanded="false" title="Filtrar por vehículos, financiera y cronograma">
                                <i class="fa fa-sliders" aria-hidden="true"/> Filtros
                                <span class="adt_f360__fpop-badge" data-ref="fpop-n"/>
                            </button>
                            <div class="adt_f360__fpop" data-ref="fpop" role="dialog" aria-label="Filtros"/>
                        </div>
                    </div>
                    <!-- Filtros aplicados desde el popup: cada uno se quita con su ×. -->
                    <div class="adt_f360__applied" data-ref="aplicados" aria-label="Filtros aplicados"/>
                    <!-- Pestañas de estado (Todos, Requiere atención, …) debajo de los filtros aplicados. -->
                    <nav class="adt_f360__filters" data-ref="filtros" aria-label="Filtros"/>
                </header>
                <section class="adt_f360__figures" data-ref="cartera" aria-label="Resumen de la selección"/>
                <section class="adt_f360__table-wrap" data-ref="grid" aria-live="polite"/>
                <div class="adt_f360__more" data-ref="more"/>
            </div>
            <section class="adt_f360__drawer" data-ref="drawer" role="region" aria-label="Ficha del vehículo"/>
            <div class="adt_f360__modal-root" data-ref="modal"/>
            <input type="file" class="d-none" data-ref="archivo" accept="image/*,application/pdf" tabindex="-1" aria-hidden="true"/>
        </div>
    </t>

</templates>
