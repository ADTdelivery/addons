<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_adt_flota_360" model="ir.actions.client">
        <field name="name">Flota 360</field>
        <field name="tag">adt_flota_360</field>
    </record>

    <!-- Menú "Flota 360" de la app Flota, numerado:
         1. Consulta de vehículos  2. SAT (papeletas y capturas)  3. Captura vehicular  4. Finanzas  5. Tracking de motos
         6. Carga de cronogramas.
         Las demás vistas quedan ocultas (active=False) por ahora; para volver a
         mostrarlas basta con quitar ese atributo. -->
    <menuitem id="menu_adt_flota_360_root"
              name="Flota 360"
              parent="fleet.menu_root"
              groups="fleet.fleet_group_user"
              sequence="1"/>

    <menuitem id="menu_adt_flota_360"
              name="1. Consulta de vehículos"
              parent="menu_adt_flota_360_root"
              action="action_adt_flota_360"
              groups="fleet.fleet_group_user"
              sequence="1"/>

    <!-- Las vistas de flota de adt_comercial se mueven aquí. Se hace desde este
         módulo (que depende de adt_comercial) para que el menú no dependa del
         orden en que se actualicen los módulos. -->
    <!-- Ocultas por ahora. -->
    <record id="adt_comercial.menu_fleet_candidatos_prestamo" model="ir.ui.menu">
        <field name="parent_id" ref="menu_adt_flota_360_root"/>
        <field name="active" eval="False"/>
    </record>

    <record id="adt_comercial.menu_fleet_traspaso_notarial" model="ir.ui.menu">
        <field name="parent_id" ref="menu_adt_flota_360_root"/>
        <field name="active" eval="False"/>
    </record>

    <!-- Finanzas: el dashboard de Cartera y financieras (sigue también en Comercial > Dashboards). -->
    <menuitem id="menu_adt_flota_360_cartera"
              name="4. Finanzas"
              parent="menu_adt_flota_360_root"
              action="adt_comercial.action_cartera_reporte"
              sequence="4"
              groups="adt_comercial.group_access_adt_comercial_gerencia"/>

    <record id="action_cobranza_rentabilidad" model="ir.actions.client">
        <field name="name">Cobranza y rentabilidad</field>
        <field name="tag">adt_flota_360_cobranza_rentabilidad</field>
    </record>
    <menuitem id="menu_adt_flota_360_cobranza_rentabilidad"
              name="Cobranza y rentabilidad"
              parent="menu_adt_flota_360_root"
              action="action_cobranza_rentabilidad"
              sequence="9"
              active="False"
              groups="adt_comercial.group_access_adt_comercial_gerencia"/>

    <record id="action_flota_360_indicadores" model="ir.actions.client">
        <field name="name">SAT</field>
        <field name="tag">adt_flota_360_indicadores</field>
    </record>
    <menuitem id="menu_adt_flota_360_indicadores"
              name="2. SAT"
              parent="menu_adt_flota_360_root"
              action="action_flota_360_indicadores"
              sequence="2"
              groups="adt_comercial.group_access_adt_comercial_gerencia"/>

    <!-- Capturas paso a paso: posibles capturas (cuotas vencidas o papeletas SAT) hasta el cierre. -->
    <record id="action_flota_360_capturas" model="ir.actions.client">
        <field name="name">Captura vehicular</field>
        <field name="tag">adt_flota_360_capturas</field>
    </record>
    <menuitem id="menu_adt_flota_360_capturas"
              name="3. Captura vehicular"
              parent="menu_adt_flota_360_root"
              action="action_flota_360_capturas"
              sequence="3"
              groups="fleet.fleet_group_user"/>

    <!-- Tracking de motos en una sola vista: indicadores por etapa, tablero (logística y
         placa desde la misma tarjeta), detalle de la moto y configuración en un drawer.
         Requiere adt_tracking_moto; si no está instalado la vista lo indica. -->
    <record id="action_flota_360_tracking" model="ir.actions.client">
        <field name="name">Tracking de motos</field>
        <field name="tag">adt_flota_360_tracking</field>
    </record>
    <menuitem id="menu_adt_flota_360_tracking"
              name="5. Tracking de motos"
              parent="menu_adt_flota_360_root"
              action="action_flota_360_tracking"
              sequence="5"
              groups="fleet.fleet_group_user"/>

    <!-- Carga masiva de los cronogramas (plan de pagos) de la financiera: PDF, ZIP o carpetas.
         Se traslada aquí desde Comercial > Financiera; el lote y la lectura siguen en adt_comercial. -->
    <record id="action_flota_360_carga_pdf" model="ir.actions.client">
        <field name="name">Carga de cronogramas</field>
        <field name="tag">adt_flota_360_carga_pdf</field>
    </record>
    <menuitem id="menu_adt_flota_360_carga_pdf"
              name="6. Carga de cronogramas"
              parent="menu_adt_flota_360_root"
              action="action_flota_360_carga_pdf"
              sequence="6"
              groups="adt_comercial.group_access_adt_comercial_gerencia"/>
    <record id="adt_comercial.adt_comercial_menu_financiera_carga_pdf" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="action_carteras" model="ir.actions.client">
        <field name="name">Carteras de cobranza</field>
        <field name="tag">adt_flota_360_carteras</field>
    </record>
    <menuitem id="menu_carteras" name="Carteras de cobranza" parent="menu_adt_flota_360_root"
              action="action_carteras" sequence="11" groups="fleet.fleet_group_user" active="False"/>
    <record id="action_mi_cartera" model="ir.actions.client">
        <field name="name">Mi cartera</field>
        <field name="tag">adt_flota_360_carteras</field>
    </record>
    <menuitem id="menu_mi_cartera_root" name="Mi cartera" action="action_mi_cartera"
              sequence="8" groups="adt_flota_360.group_cobrador"/>
</odoo>
