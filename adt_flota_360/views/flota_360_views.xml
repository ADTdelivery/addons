<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_adt_flota_360" model="ir.actions.client">
        <field name="name">Flota 360</field>
        <field name="tag">adt_flota_360</field>
    </record>

    <!-- Menú "Flota 360" de la app Flota: agrupa la consulta 360 y las vistas de
         otros módulos que se cuelgan aquí (p. ej. candidatos a préstamo y
         traspaso notarial de adt_comercial). -->
    <menuitem id="menu_adt_flota_360_root"
              name="Flota 360"
              parent="fleet.menu_root"
              groups="fleet.fleet_group_user"
              sequence="1"/>

    <menuitem id="menu_adt_flota_360"
              name="Consulta de vehículos"
              parent="menu_adt_flota_360_root"
              action="action_adt_flota_360"
              groups="fleet.fleet_group_user"
              sequence="1"/>

    <!-- Las vistas de flota de adt_comercial se mueven aquí. Se hace desde este
         módulo (que depende de adt_comercial) para que el menú no dependa del
         orden en que se actualicen los módulos. -->
    <record id="adt_comercial.menu_fleet_candidatos_prestamo" model="ir.ui.menu">
        <field name="parent_id" ref="menu_adt_flota_360_root"/>
    </record>

    <record id="adt_comercial.menu_fleet_traspaso_notarial" model="ir.ui.menu">
        <field name="parent_id" ref="menu_adt_flota_360_root"/>
    </record>

    <!-- Acceso directo al dashboard de Cartera y financieras (sigue también en Comercial > Dashboards). -->
    <menuitem id="menu_adt_flota_360_cartera"
              name="Cartera y financieras"
              parent="menu_adt_flota_360_root"
              action="adt_comercial.action_cartera_reporte"
              sequence="10"
              groups="adt_comercial.group_access_adt_comercial_gerencia"/>

    <record id="action_carteras" model="ir.actions.client">
        <field name="name">Carteras de cobranza</field>
        <field name="tag">adt_flota_360_carteras</field>
    </record>
    <menuitem id="menu_carteras" name="Carteras de cobranza" parent="menu_adt_flota_360_root"
              action="action_carteras" sequence="11" groups="fleet.fleet_group_user"/>
    <record id="action_mi_cartera" model="ir.actions.client">
        <field name="name">Mi cartera</field>
        <field name="tag">adt_flota_360_carteras</field>
    </record>
    <menuitem id="menu_mi_cartera_root" name="Mi cartera" action="action_mi_cartera"
              sequence="8" groups="adt_flota_360.group_cobrador"/>
</odoo>
