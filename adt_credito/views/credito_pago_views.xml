<odoo>
    <data>
        <record id="view_credito_pago_list" model="ir.ui.view">
            <field name="name">credito.pago.list</field>
            <field name="model">credito.pago</field>
            <field name="arch" type="xml">
                <tree string="Pagos">
                    <field name="fecha_pago"/>
                    <field name="contrato_id"/>
                    <field name="partner_id"/>
                    <field name="cuota_id"/>
                    <field name="tipo"/>
                    <field name="monto"/>
                    <field name="metodo_pago"/>
                    <field name="referencia"/>
                    <field name="cobrador_id"/>
                </tree>
            </field>
        </record>

        <record id="view_credito_pago_form" model="ir.ui.view">
            <field name="name">credito.pago.form</field>
            <field name="model">credito.pago</field>
            <field name="arch" type="xml">
                <form string="Pago">
                    <group>
                        <group>
                            <field name="cuota_id"/>
                            <field name="contrato_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="tipo"/>
                            <field name="fecha_pago"/>
                            <field name="monto"/>
                            <field name="metodo_pago"/>
                            <field name="referencia"/>
                            <field name="cobrador_id"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_credito_pago" model="ir.actions.act_window">
            <field name="name">Pagos</field>
            <field name="res_model">credito.pago</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
