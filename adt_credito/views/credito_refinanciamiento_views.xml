<odoo>
    <data>
        <record id="view_credito_refinanciamiento_form" model="ir.ui.view">
            <field name="name">credito.refinanciamiento.form</field>
            <field name="model">credito.refinanciamiento</field>
            <field name="arch" type="xml">
                <form string="Refinanciar contrato">
                    <group>
                        <field name="contrato_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="saldo_a_refinanciar" readonly="1"/>
                    </group>
                    <group string="Nuevas condiciones">
                        <field name="frecuencia"/>
                        <field name="numero_cuotas"/>
                        <field name="fecha_inicio"/>
                    </group>
                    <footer>
                        <button name="action_confirmar" type="object" string="Refinanciar" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_credito_refinanciamiento" model="ir.actions.act_window">
            <field name="name">Refinanciar</field>
            <field name="res_model">credito.refinanciamiento</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
