<odoo>
    <data>
        <record id="view_credito_registrar_pago_form" model="ir.ui.view">
            <field name="name">credito.registrar.pago.form</field>
            <field name="model">credito.registrar.pago</field>
            <field name="arch" type="xml">
                <form string="Registrar pago">
                    <group>
                        <field name="contrato_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="cuota_id"/>
                        <field name="tipo"/>
                        <field name="monto"/>
                    </group>
                    <group>
                        <field name="fecha_pago"/>
                        <field name="metodo_pago"/>
                        <field name="referencia"/>
                    </group>
                    <footer>
                        <button name="action_confirmar" type="object" string="Registrar pago" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
