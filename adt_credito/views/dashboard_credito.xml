<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- En un momento este xmlid fue un ir.actions.client (dashboard embebido en un
     iframe dentro del layout de Odoo) — se descartó ese enfoque porque el cálculo del
     alto disponible dependía de clases internas del tema (muk_web_theme) que no se
     pudieron determinar sin inspección en vivo, y quedaba mal renderizado. Se vuelve a
     una pestaña aislada (ir.actions.act_url): abre la misma página, fuera del layout
     de Odoo, sin los problemas de tamaño. El <delete> cubre una actualización desde esa
     versión intermedia; en una instalación nueva no encuentra nada y no hace nada. -->
<delete model="ir.actions.client" id="action_dashboard_credito"/>

<record id="action_dashboard_credito" model="ir.actions.act_url">
    <field name="name">Dashboard de Crédito</field>
    <field name="url">/web/dashboard/credito</field>
    <field name="target">self</field>
</record>

<template id="dashboard_credito" name="Dashboard de Crédito">
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Dashboard de Crédito</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { font-family: 'Segoe UI', system-ui, sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }
  .dash-wrapper  { max-width: 1400px; margin: 0 auto; padding: 24px 20px 48px; }
  .dash-topbar   { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 22px; }
  .dash-title    { font-size: 1.6rem; font-weight: 700; color: #f8fafc; letter-spacing: -0.3px; }
  .dash-title span { color: #38bdf8; }
  .dash-subtitle { font-size: 0.82rem; color: #94a3b8; margin-top: 3px; }
  .period-tabs   { display: flex; gap: 6px; background: #1e293b; border-radius: 12px; padding: 5px; flex-wrap: wrap; }
  .period-btn    { padding: 7px 18px; border-radius: 8px; border: none; cursor: pointer; font-size: 0.82rem; font-weight: 600;
                   background: transparent; color: #94a3b8; transition: all .2s; text-decoration: none; display: inline-block; font-family: inherit; }
  .period-btn:hover  { background: #334155; color: #e2e8f0; }
  .period-btn.active { background: #0ea5e9; color: #fff; box-shadow: 0 2px 8px rgba(14,165,233,.4); }

  .kpi-grid  { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 26px; }
  .kpi-card  { background: #1e293b; border-radius: 16px; padding: 18px 20px; position: relative; overflow: hidden;
               border: 1px solid #334155; transition: transform .2s, box-shadow .2s; }
  .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(0,0,0,.35); }
  .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: 16px 16px 0 0; }
  .kpi-card.c-cartera::before   { background: linear-gradient(90deg, #0ea5e9, #38bdf8); }
  .kpi-card.c-saldo::before     { background: linear-gradient(90deg, #6366f1, #818cf8); }
  .kpi-card.c-mora::before      { background: linear-gradient(90deg, #ef4444, #f87171); }
  .kpi-card.c-vencidas::before  { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
  .kpi-card.c-pctmora::before   { background: linear-gradient(90deg, #ef4444, #fb7185); }
  .kpi-card.c-recaudo::before   { background: linear-gradient(90deg, #22c55e, #4ade80); }
  .kpi-card.c-ticket::before    { background: linear-gradient(90deg, #06b6d4, #22d3ee); }
  .kpi-card.c-contratos::before { background: linear-gradient(90deg, #a855f7, #c084fc); }
  .kpi-card.c-ganancia::before  { background: linear-gradient(90deg, #22c55e, #86efac); }
  .kpi-card.c-costo::before     { background: linear-gradient(90deg, #f97316, #fdba74); }
  .kpi-card.c-margen::before    { background: linear-gradient(90deg, #14b8a6, #5eead4); }
  .kpi-value.negativo { color: #f87171; }
  .kpi-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .6px; color: #64748b; margin-bottom: 6px; }
  .kpi-value { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.5px; line-height: 1; color: #f1f5f9; }
  .kpi-sub   { font-size: 0.72rem; color: #64748b; margin-top: 6px; }

  .charts-grid  { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; margin-bottom: 18px; }
  @media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }
  .panel        { background: #1e293b; border-radius: 16px; padding: 20px 22px; border: 1px solid #334155; }
  .panel-title  { font-size: 0.86rem; font-weight: 700; color: #cbd5e1; margin-bottom: 16px; }

  .bar-chart    { display: flex; align-items: flex-end; gap: 6px; height: 180px; }
  .bar-col      { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
  .bar-fill     { width: 100%; max-width: 22px; background: linear-gradient(180deg, #38bdf8, #0ea5e9); border-radius: 4px 4px 0 0;
                  min-height: 2px; transition: height .3s; }
  .bar-tip      { font-size: 0.6rem; color: #64748b; margin-top: 6px; writing-mode: vertical-rl; text-orientation: mixed; }

  .semaforo-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .semaforo-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
  .semaforo-track { flex: 1; background: #0f172a; border-radius: 8px; height: 10px; overflow: hidden; }
  .semaforo-fill { height: 100%; border-radius: 8px; }
  .semaforo-label { font-size: 0.78rem; color: #cbd5e1; width: 110px; flex-shrink: 0; }
  .semaforo-count { font-size: 0.78rem; color: #94a3b8; width: 60px; text-align: right; flex-shrink: 0; }

  .prod-row  { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .prod-name { font-size: 0.78rem; color: #cbd5e1; width: 140px; flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .prod-track { flex: 1; background: #0f172a; border-radius: 8px; height: 10px; overflow: hidden; }
  .prod-fill { height: 100%; border-radius: 8px; }
  .prod-amount { font-size: 0.72rem; color: #64748b; width: 90px; text-align: right; flex-shrink: 0; }
  .empty-state { color: #64748b; font-size: 0.8rem; padding: 20px 0; text-align: center; }
</style>
</head>
<body>
<div class="dash-wrapper">
  <div class="dash-topbar">
    <div>
      <div class="dash-title">Dashboard de <span>Crédito</span></div>
      <div class="dash-subtitle">Cartera, mora y recaudo — actualizado al momento de abrir esta página</div>
    </div>
    <div class="period-tabs">
      <a class="period-btn" id="tabDia" t-attf-href="/web/dashboard/credito?periodo=dia">Hoy</a>
      <a class="period-btn" id="tabSemana" t-attf-href="/web/dashboard/credito?periodo=semana">Semana</a>
      <a class="period-btn" id="tabMes" t-attf-href="/web/dashboard/credito?periodo=mes">Mes</a>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-card c-contratos">
      <div class="kpi-label">Contratos vivos</div>
      <div class="kpi-value"><t t-esc="n_contratos"/></div>
      <div class="kpi-sub">Activos + en mora</div>
    </div>
    <div class="kpi-card c-cartera">
      <div class="kpi-label">Cartera financiada</div>
      <div class="kpi-value"><t t-esc="moneda"/> <t t-esc="'{:,.2f}'.format(cartera_financiada)"/></div>
      <div class="kpi-sub">Suma de montos financiados</div>
    </div>
    <div class="kpi-card c-saldo">
      <div class="kpi-label">Saldo pendiente</div>
      <div class="kpi-value"><t t-esc="moneda"/> <t t-esc="'{:,.2f}'.format(saldo_pendiente)"/></div>
      <div class="kpi-sub">Lo que aún falta cobrar</div>
    </div>
    <div class="kpi-card c-mora">
      <div class="kpi-label">Mora acumulada</div>
      <div class="kpi-value"><t t-esc="moneda"/> <t t-esc="'{:,.2f}'.format(mora_total)"/></div>
      <div class="kpi-sub">Sobre cuotas vencidas</div>
    </div>
    <div class="kpi-card c-vencidas">
      <div class="kpi-label">Cuotas vencidas</div>
      <div class="kpi-value"><t t-esc="cuotas_vencidas"/></div>
      <div class="kpi-sub">En todos los contratos vivos</div>
    </div>
    <div class="kpi-card c-pctmora">
      <div class="kpi-label">% cartera en mora</div>
      <div class="kpi-value"><t t-esc="pct_en_mora"/>%</div>
      <div class="kpi-sub">Contratos en semáforo rojo</div>
    </div>
    <div class="kpi-card c-recaudo">
      <div class="kpi-label">Recaudado del período</div>
      <div class="kpi-value"><t t-esc="moneda"/> <t t-esc="'{:,.2f}'.format(recaudado_total)"/></div>
      <div class="kpi-sub">Cuota <t t-esc="moneda"/><t t-esc="'{:,.2f}'.format(recaudado_cuota)"/> · Mora <t t-esc="moneda"/><t t-esc="'{:,.2f}'.format(recaudado_mora)"/></div>
    </div>
    <div class="kpi-card c-ticket">
      <div class="kpi-label">Ticket promedio</div>
      <div class="kpi-value"><t t-esc="moneda"/> <t t-esc="'{:,.2f}'.format(ticket_promedio)"/></div>
      <div class="kpi-sub">Por pago registrado en el período</div>
    </div>
    <div class="kpi-card c-ganancia">
      <div class="kpi-label">Ganancia (todos los préstamos)</div>
      <div t-attf-class="kpi-value #{'negativo' if ganancia_total &lt; 0 else ''}"><t t-esc="moneda"/> <t t-esc="'{:,.2f}'.format(ganancia_total)"/></div>
      <div class="kpi-sub">Venta − costo, <t t-esc="n_prestamos"/> préstamos confirmados</div>
    </div>
    <div class="kpi-card c-costo">
      <div class="kpi-label">Costo de la cartera</div>
      <div class="kpi-value"><t t-esc="moneda"/> <t t-esc="'{:,.2f}'.format(costo_total)"/></div>
      <div class="kpi-sub">Costo estándar del producto × cantidad</div>
    </div>
    <div class="kpi-card c-margen">
      <div class="kpi-label">Margen</div>
      <div t-attf-class="kpi-value #{'negativo' if margen_pct &lt; 0 else ''}"><t t-esc="margen_pct"/>%</div>
      <div class="kpi-sub">Ganancia / venta total</div>
    </div>
  </div>

  <div class="charts-grid">
    <div class="panel">
      <div class="panel-title">Recaudo por día (últimos 14 días)</div>
      <div class="bar-chart" id="barChart"></div>
    </div>
    <div class="panel">
      <div class="panel-title">Estado de la cartera (semáforo)</div>
      <div class="semaforo-row">
        <span class="semaforo-dot" style="background:#22c55e;"></span>
        <span class="semaforo-label">Al día</span>
        <div class="semaforo-track"><div class="semaforo-fill" id="fillVerde" style="background:#22c55e;"></div></div>
        <span class="semaforo-count"><t t-esc="n_verde"/></span>
      </div>
      <div class="semaforo-row">
        <span class="semaforo-dot" style="background:#f59e0b;"></span>
        <span class="semaforo-label">Retrasados</span>
        <div class="semaforo-track"><div class="semaforo-fill" id="fillAmarillo" style="background:#f59e0b;"></div></div>
        <span class="semaforo-count"><t t-esc="n_amarillo"/></span>
      </div>
      <div class="semaforo-row">
        <span class="semaforo-dot" style="background:#ef4444;"></span>
        <span class="semaforo-label">En mora</span>
        <div class="semaforo-track"><div class="semaforo-fill" id="fillRojo" style="background:#ef4444;"></div></div>
        <span class="semaforo-count"><t t-esc="n_rojo"/></span>
      </div>
    </div>
  </div>

  <div class="charts-grid">
    <div class="panel">
      <div class="panel-title">Top productos por cartera financiada</div>
      <div id="topProductos"></div>
    </div>
    <div class="panel">
      <div class="panel-title">Ganancia por producto (todos los préstamos)</div>
      <div id="topGanancia"></div>
    </div>
  </div>

  <div id="dashData"
       t-att-data-serie="serie_diaria_json"
       t-att-data-top-productos="top_productos_json"
       t-att-data-top-ganancia="top_ganancia_json"
       t-att-data-palette="palette_json"
       t-att-data-verde="n_verde"
       t-att-data-amarillo="n_amarillo"
       t-att-data-rojo="n_rojo"
       t-att-data-moneda="moneda"
       t-att-data-periodo="periodo_activo"
       style="display:none;"></div>
</div>

<script>
//<![CDATA[
(function(){
  'use strict';

  var el = document.getElementById('dashData');
  var serie = [], topProductos = [], topGanancia = [], palette = ['#3987e5'];
  var nVerde = 0, nAmarillo = 0, nRojo = 0, moneda = '';

  if (el) {
    try { serie = JSON.parse(el.getAttribute('data-serie') || '[]'); } catch(e){}
    try { topProductos = JSON.parse(el.getAttribute('data-top-productos') || '[]'); } catch(e){}
    try { topGanancia = JSON.parse(el.getAttribute('data-top-ganancia') || '[]'); } catch(e){}
    try { palette = JSON.parse(el.getAttribute('data-palette') || '[]'); } catch(e){}
    nVerde = parseInt(el.getAttribute('data-verde') || '0', 10) || 0;
    nAmarillo = parseInt(el.getAttribute('data-amarillo') || '0', 10) || 0;
    nRojo = parseInt(el.getAttribute('data-rojo') || '0', 10) || 0;
    moneda = el.getAttribute('data-moneda') || '';
  }

  function markActiveTab() {
    var periodo = (el && el.getAttribute('data-periodo')) || 'mes';
    ['dia','semana','mes'].forEach(function(p){
      var btn = document.getElementById('tab' + p.charAt(0).toUpperCase() + p.slice(1));
      if (btn) btn.classList.toggle('active', periodo === p);
    });
  }

  function renderBarChart() {
    var container = document.getElementById('barChart');
    if (!container) return;
    if (!serie.length) { container.innerHTML = '<div class="empty-state">Sin pagos registrados en estos días</div>'; return; }
    var max = Math.max.apply(null, serie.map(function(d){ return d.monto; })) || 1;
    container.innerHTML = '';
    serie.forEach(function(d){
      var col = document.createElement('div');
      col.className = 'bar-col';
      var fill = document.createElement('div');
      fill.className = 'bar-fill';
      var pct = Math.max((d.monto / max) * 100, d.monto > 0 ? 3 : 0);
      fill.style.height = pct + '%';
      fill.title = d.fecha + ': ' + moneda + ' ' + d.monto.toFixed(2);
      var tip = document.createElement('div');
      tip.className = 'bar-tip';
      tip.textContent = d.fecha;
      col.appendChild(fill);
      col.appendChild(tip);
      container.appendChild(col);
    });
  }

  function renderSemaforo() {
    var total = nVerde + nAmarillo + nRojo;
    var pct = function(n){ return total ? Math.max((n / total) * 100, n > 0 ? 3 : 0) : 0; };
    var fv = document.getElementById('fillVerde');
    var fa = document.getElementById('fillAmarillo');
    var fr = document.getElementById('fillRojo');
    if (fv) fv.style.width = pct(nVerde) + '%';
    if (fa) fa.style.width = pct(nAmarillo) + '%';
    if (fr) fr.style.width = pct(nRojo) + '%';
  }

  function renderTopProductos() {
    var container = document.getElementById('topProductos');
    if (!container) return;
    if (!topProductos.length) { container.innerHTML = '<div class="empty-state">Sin contratos vivos todavía</div>'; return; }
    var max = Math.max.apply(null, topProductos.map(function(p){ return p.monto; })) || 1;
    container.innerHTML = '';
    topProductos.forEach(function(p, idx){
      var row = document.createElement('div');
      row.className = 'prod-row';
      var color = palette[idx % palette.length];
      var pct = Math.max((p.monto / max) * 100, 3);
      row.innerHTML =
        '<span class="prod-name" title="' + p.nombre.replace(/"/g,'&quot;') + '">' + p.nombre + '</span>' +
        '<div class="prod-track"><div class="prod-fill" style="width:' + pct + '%;background:' + color + ';"></div></div>' +
        '<span class="prod-amount">' + moneda + ' ' + p.monto.toFixed(2) + '</span>';
      container.appendChild(row);
    });
  }

  function renderTopGanancia() {
    var container = document.getElementById('topGanancia');
    if (!container) return;
    if (!topGanancia.length) { container.innerHTML = '<div class="empty-state">Sin préstamos confirmados todavía</div>'; return; }
    var max = Math.max.apply(null, topGanancia.map(function(p){ return Math.abs(p.monto); })) || 1;
    container.innerHTML = '';
    topGanancia.forEach(function(p){
      var row = document.createElement('div');
      row.className = 'prod-row';
      var esNegativo = p.monto < 0;
      var color = esNegativo ? '#ef4444' : '#22c55e';
      var pct = Math.max((Math.abs(p.monto) / max) * 100, 3);
      row.innerHTML =
        '<span class="prod-name" title="' + p.nombre.replace(/"/g,'&quot;') + '">' + p.nombre + '</span>' +
        '<div class="prod-track"><div class="prod-fill" style="width:' + pct + '%;background:' + color + ';"></div></div>' +
        '<span class="prod-amount"' + (esNegativo ? ' style="color:#f87171;"' : '') + '>' + moneda + ' ' + p.monto.toFixed(2) + '</span>';
      container.appendChild(row);
    });
  }

  markActiveTab();
  renderBarChart();
  renderSemaforo();
  renderTopProductos();
  renderTopGanancia();
})();
//]]>
</script>
</body>
</html>
</template>
</odoo>
