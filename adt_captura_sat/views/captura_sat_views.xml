<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Órdenes de captura ============ -->
    <record id="view_adt_captura_sat_tree" model="ir.ui.view">
        <field name="name">adt.captura.sat.tree</field>
        <field name="model">adt.captura.sat</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-muted="not vigente" decoration-danger="vigente and gestion == 'nueva'"
                  decoration-warning="vigente and gestion == 'en_gestion'">
                <field name="placa"/>
                <field name="vehicle_id" optional="show"/>
                <field name="driver_id" optional="show"/>
                <field name="name"/>
                <field name="anio" optional="hide"/>
                <field name="concepto"/>
                <field name="placa_original" optional="hide"/>
                <field name="referencia" optional="hide"/>
                <field name="monto" sum="Total"/>
                <field name="primera_vez_visto"/>
                <field name="dias"/>
                <field name="ultima_vez_visto" optional="show"/>
                <field name="fecha_actualizacion_sat" optional="hide"/>
                <field name="vigente" widget="boolean" optional="show"/>
                <field name="gestion" widget="badge" decoration-danger="gestion == 'nueva'"
                       decoration-warning="gestion == 'en_gestion'" decoration-success="gestion == 'resuelta'"/>
                <field name="responsable_id" optional="show" widget="many2one_avatar_user"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_adt_captura_sat_form" model="ir.ui.view">
        <field name="name">adt.captura.sat.form</field>
        <field name="model">adt.captura.sat</field>
        <field name="arch" type="xml">
            <form string="Orden de captura SAT" create="false">
                <header>
                    <button name="action_en_gestion" type="object" string="Tomar gestión" class="oe_highlight"
                            attrs="{'invisible': ['|', ('gestion', '!=', 'nueva'), ('vigente', '=', False)]}"/>
                    <button name="action_resuelta" type="object" string="Marcar resuelta"
                            attrs="{'invisible': [('gestion', '=', 'resuelta')]}"/>
                    <button name="action_vincular_vehiculo" type="object" string="Buscar vehículo"
                            attrs="{'invisible': [('vehicle_id', '!=', False)]}"/>
                    <field name="gestion" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <div class="alert alert-danger" role="alert" attrs="{'invisible': [('vigente', '=', False)]}">
                    <strong>Orden de captura vigente en el SAT Lima</strong> desde hace
                    <field name="dias" readonly="1" nolabel="1" class="oe_inline"/> días.
                    El vehículo puede ser internado en el depósito.
                </div>
                <div class="alert alert-success" role="alert" attrs="{'invisible': [('vigente', '=', True)]}">
                    Ya no figura en el SAT desde el <field name="levantada_en" readonly="1" class="oe_inline"/>.
                </div>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3><field name="placa"/></h3>
                    </div>
                    <group>
                        <group string="Datos del SAT">
                            <field name="concepto"/>
                            <field name="anio"/>
                            <field name="placa_original"/>
                            <field name="referencia"/>
                            <field name="monto"/>
                            <field name="fecha_actualizacion_sat"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Vehículo y gestión">
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="responsable_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Seguimiento">
                            <field name="vigente"/>
                            <field name="primera_vez_visto"/>
                            <field name="ultima_vez_visto"/>
                            <field name="levantada_en"/>
                            <field name="consulta_id"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Notas de la gestión (pago, descargo, coordinación con el cliente)…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_adt_captura_sat_kanban" model="ir.ui.view">
        <field name="name">adt.captura.sat.kanban</field>
        <field name="model">adt.captura.sat</field>
        <field name="arch" type="xml">
            <kanban default_group_by="gestion" create="false" class="o_kanban_small_column">
                <field name="placa"/>
                <field name="name"/>
                <field name="monto"/>
                <field name="vigente"/>
                <field name="dias"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="placa"/></strong>
                                <span t-if="record.vigente.raw_value" class="badge badge-danger">Vigente</span>
                                <span t-else="" class="badge badge-secondary">Levantada</span>
                            </div>
                            <div><field name="vehicle_id"/></div>
                            <div class="text-muted">Doc. <field name="name"/> · <field name="concepto"/></div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <strong><field name="monto" widget="monetary"/></strong>
                                    <span class="text-muted"> · <t t-esc="record.dias.value"/> días</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                    <field name="responsable_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_adt_captura_sat_search" model="ir.ui.view">
        <field name="name">adt.captura.sat.search</field>
        <field name="model">adt.captura.sat</field>
        <field name="arch" type="xml">
            <search>
                <field name="placa"/>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter name="vigentes" string="Vigentes" domain="[('vigente', '=', True)]"/>
                <filter name="levantadas" string="Levantadas" domain="[('vigente', '=', False)]"/>
                <separator/>
                <filter name="nuevas" string="Nuevas (sin gestionar)" domain="[('gestion', '=', 'nueva')]"/>
                <filter name="en_gestion" string="En gestión" domain="[('gestion', '=', 'en_gestion')]"/>
                <filter name="mias" string="Mis gestiones" domain="[('responsable_id', '=', uid)]"/>
                <separator/>
                <filter name="sin_vehiculo" string="Sin vehículo" domain="[('vehicle_id', '=', False)]"/>
                <filter name="f_detectada" string="Detectada" date="primera_vez_visto"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_placa" string="Placa" context="{'group_by': 'placa'}"/>
                    <filter name="g_gestion" string="Gestión" context="{'group_by': 'gestion'}"/>
                    <filter name="g_concepto" string="Concepto" context="{'group_by': 'concepto'}"/>
                    <filter name="g_responsable" string="Responsable" context="{'group_by': 'responsable_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adt_captura_sat_alertas" model="ir.actions.act_window">
        <field name="name">Órdenes de captura vigentes</field>
        <field name="res_model">adt.captura.sat</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_adt_captura_sat_search"/>
        <field name="context">{'search_default_vigentes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ningún vehículo con orden de captura vigente</p>
            <p>Las órdenes llegan desde el agente de capturas SAT (Docker) por /api/capturas/sat/import.</p>
        </field>
    </record>

    <record id="action_adt_captura_sat" model="ir.actions.act_window">
        <field name="name">Historial de órdenes</field>
        <field name="res_model">adt.captura.sat</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_adt_captura_sat_search"/>
    </record>

    <!-- ============ Consultas ============ -->
    <record id="view_adt_captura_sat_consulta_tree" model="ir.ui.view">
        <field name="name">adt.captura.sat.consulta.tree</field>
        <field name="model">adt.captura.sat.consulta</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-danger="state == 'error' or resultado == 'con_orden'"
                  decoration-muted="state == 'omitido'">
                <field name="consultado_en"/>
                <field name="placa"/>
                <field name="vehicle_id"/>
                <field name="ejecucion_id" optional="show"/>
                <field name="resultado" widget="badge" decoration-danger="resultado == 'con_orden'"
                       decoration-success="resultado == 'sin_orden'" decoration-warning="resultado == 'indeterminado'"/>
                <field name="cantidad"/>
                <field name="monto_total" sum="Total"/>
                <field name="nuevas"/>
                <field name="levantadas"/>
                <field name="mensaje" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'ok'" decoration-danger="state == 'error'"/>
            </tree>
        </field>
    </record>

    <record id="view_adt_captura_sat_consulta_form" model="ir.ui.view">
        <field name="name">adt.captura.sat.consulta.form</field>
        <field name="model">adt.captura.sat.consulta</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_reprocesar" type="object" string="Reprocesar" groups="base.group_system"
                            attrs="{'invisible': [('state', '!=', 'error')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-warning" role="alert" attrs="{'invisible': [('resultado', '!=', 'indeterminado')]}">
                    El SAT no devolvió un resultado reconocible (captcha rechazado, sesión vencida o mantenimiento).
                    No se modificó ninguna orden.
                </div>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="placa"/>
                            <field name="vehicle_id"/>
                            <field name="ejecucion_id"/>
                            <field name="consultado_en"/>
                            <field name="resultado"/>
                            <field name="mensaje"/>
                            <field name="fecha_actualizacion_sat"/>
                        </group>
                        <group>
                            <field name="cantidad"/>
                            <field name="monto_total"/>
                            <field name="detalle_completo"/>
                            <field name="nuevas"/>
                            <field name="actualizadas"/>
                            <field name="levantadas"/>
                        </group>
                    </group>
                    <group string="Error" attrs="{'invisible': [('error', '=', False)]}">
                        <field name="error" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Respuesta SAT" name="respuesta">
                            <field name="respuesta_sat"/>
                        </page>
                        <page string="Filas no interpretadas" name="filas"
                              attrs="{'invisible': [('filas_no_interpretadas', '=', False)]}">
                            <field name="filas_no_interpretadas"/>
                        </page>
                        <page string="Payload" name="payload" groups="base.group_system">
                            <field name="payload"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_adt_captura_sat_consulta_search" model="ir.ui.view">
        <field name="name">adt.captura.sat.consulta.search</field>
        <field name="model">adt.captura.sat.consulta</field>
        <field name="arch" type="xml">
            <search>
                <field name="placa"/>
                <field name="vehicle_id"/>
                <field name="ejecucion_id"/>
                <filter name="con_orden" string="Con orden" domain="[('resultado', '=', 'con_orden')]"/>
                <filter name="indeterminadas" string="No determinadas" domain="[('resultado', '=', 'indeterminado')]"/>
                <filter name="errores" string="Errores" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="f_consulta" string="Fecha de consulta" date="consultado_en"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_ejecucion" string="Ejecución" context="{'group_by': 'ejecucion_id'}"/>
                    <filter name="g_resultado" string="Resultado" context="{'group_by': 'resultado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_adt_captura_sat_consulta" model="ir.actions.act_window">
        <field name="name">Consultas SAT</field>
        <field name="res_model">adt.captura.sat.consulta</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_adt_captura_sat_consulta_search"/>
    </record>
</odoo>
