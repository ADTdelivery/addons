<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_form_captura_sat" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.captura.sat</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="captura_sat_estado" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert"
                     attrs="{'invisible': [('captura_sat_estado', '!=', 'con_orden')]}">
                    <strong>Orden de captura SAT:</strong> el SAT Lima muestra orden de captura para este vehículo
                    (<field name="captura_sat_count" readonly="1" class="oe_inline"/> documento(s),
                    S/ <field name="captura_sat_monto" readonly="1" class="oe_inline"/>).
                    <button name="action_ver_capturas_sat" type="object" string="Ver órdenes" class="btn-link p-0"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ver_capturas_sat" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                        attrs="{'invisible': [('captura_sat_estado', '=', 'sin_consultar')]}">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="captura_sat_count"/></span>
                        <span class="o_stat_text">Capturas SAT</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Capturas SAT" name="capturas_sat">
                    <group>
                        <group>
                            <field name="captura_sat_estado" widget="badge"
                                   decoration-danger="captura_sat_estado == 'con_orden'"
                                   decoration-success="captura_sat_estado == 'sin_orden'"/>
                            <field name="captura_sat_ultima_consulta"/>
                        </group>
                        <group>
                            <field name="captura_sat_count"/>
                            <field name="captura_sat_monto"/>
                        </group>
                    </group>
                    <button name="action_consultar_capturas_sat" type="object" string="Consultar ahora en SAT"
                            class="btn-secondary"
                            confirm="Se creará una ejecución para que el agente consulte esta placa. ¿Continuar?"/>
                    <field name="captura_sat_ids" readonly="1">
                        <tree decoration-muted="not vigente" decoration-danger="vigente">
                            <field name="name"/>
                            <field name="concepto"/>
                            <field name="monto" sum="Total"/>
                            <field name="primera_vez_visto"/>
                            <field name="levantada_en"/>
                            <field name="vigente"/>
                            <field name="gestion" widget="badge"/>
                            <field name="currency_id" invisible="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_tree_captura_sat" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.captura.sat</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="captura_sat_estado" optional="show" widget="badge"
                       decoration-danger="captura_sat_estado == 'con_orden'"
                       decoration-success="captura_sat_estado == 'sin_orden'"/>
                <field name="captura_sat_monto" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_search_captura_sat" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.captura.sat</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="captura_sat_con_orden" string="Con orden de captura SAT"
                        domain="[('captura_sat_estado', '=', 'con_orden')]"/>
                <filter name="captura_sat_sin_consultar" string="Captura SAT sin consultar"
                        domain="[('captura_sat_estado', '=', 'sin_consultar')]"/>
                <filter name="g_captura_sat" string="Captura SAT" context="{'group_by': 'captura_sat_estado'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_fleet_vehicle_con_captura_sat" model="ir.actions.act_window">
        <field name="name">Vehículos con orden de captura</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_captura_sat_con_orden': 1}</field>
    </record>
</odoo>
