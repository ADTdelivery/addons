<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Genera el token de la API solo si no existe. -->
    <function model="adt.captura.sat" name="_init_parametros"/>

    <data noupdate="1">
        <record id="seq_adt_captura_sat_ejecucion" model="ir.sequence">
            <field name="name">Ejecución de capturas SAT</field>
            <field name="code">adt.captura.sat.ejecucion</field>
            <field name="prefix">CAPSAT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Lanza los programas a su hora y cierra las ejecuciones que el agente no atendió. -->
        <record id="ir_cron_adt_captura_sat_programar" model="ir.cron">
            <field name="name">Capturas SAT: lanzar programas y vigilar ejecuciones</field>
            <field name="model_id" ref="model_adt_captura_sat_programa"/>
            <field name="state">code</field>
            <field name="code">model._cron_programar_y_vigilar()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

        <record id="programa_flota_diario" model="adt.captura.sat.programa">
            <field name="name">Toda la flota - diario</field>
            <field name="alcance">todas</field>
            <field name="programado" eval="False"/>
            <field name="hora">6.0</field>
        </record>
    </data>

    <record id="action_server_fleet_consultar_capturas_sat" model="ir.actions.server">
        <field name="name">Consultar capturas en SAT</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="binding_model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = env['adt.captura.sat.ejecucion'].with_context(active_ids=records.ids).action_desde_vehiculos()</field>
    </record>
</odoo>
