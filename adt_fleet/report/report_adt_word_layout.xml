<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Paperformat que replica la hoja del Word (A4, márgenes 25.4 mm).
        * margin_left/right = 0  -> el header/footer (imágenes) van a sangre.
          El margen lateral del texto lo pone .adt-doc (padding 25.4 mm).
        * margin_top / margin_bottom = 25.4 -> el cuerpo empieza/termina donde en Word.
        * header_spacing = 0 y dpi 96 sin smart-shrinking -> 1 mm CSS = 1 mm real.
        El header/footer se inyecta en models/ir_actions_report.py.
    -->
    <record id="paperformat_adt_word" model="report.paperformat">
        <field name="name">ADT Word A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25.4</field>
        <field name="margin_bottom">25.4</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <!-- Estilos equivalentes a los del .docx (Normal: Arial 11pt, interlineado 1.15) -->
    <template id="adt_word_styles">
        <style>
            html, body { margin: 0 !important; padding: 0 !important; background: #fff; }
            .adt-doc {
                padding: 0 25.4mm;
                font-family: Arial, "Nimbus Sans", "Liberation Sans", Helvetica, sans-serif;
                font-size: 11pt;
                line-height: 1.3;
                color: #000;
            }
            .adt-doc p { margin: 0 0 10pt 0; }
            .adt-doc .j { text-align: justify; }
            .adt-doc .c { text-align: center; }
            .adt-doc .r { text-align: right; }
            .adt-doc .b { font-weight: bold; }
            .adt-doc .in { margin-left: 6.35mm; }
            .adt-doc .sa0 { margin-bottom: 0; }
            .adt-doc .sa4 { margin-bottom: 4pt; }
            .adt-doc .sa6 { margin-bottom: 6pt; }
            .adt-doc .sa12 { margin-bottom: 12pt; }
            .adt-doc .sa18 { margin-bottom: 18pt; }
            .adt-doc .empty { height: 1.3em; }

            /* Viñeta con sangría francesa (Word: left 720, hanging 360) */
            .adt-doc .bul { position: relative; padding-left: 12.7mm; margin-bottom: 0; text-align: justify; }
            .adt-doc .bul:before { content: "\2022"; position: absolute; left: 6.35mm; }
            .adt-doc .bul.last { margin-bottom: 12pt; }

            .adt-doc table { border-collapse: collapse; }
            .adt-doc tr, .adt-doc .keep { page-break-inside: avoid; }

            /* Tabla de firmas */
            .adt-doc table.firmas { width: 165.1mm; margin: 0 auto; }
            .adt-doc table.firmas td { width: 50%; text-align: center; vertical-align: top; padding: 0 1.9mm; }
        </style>
    </template>

</odoo>
