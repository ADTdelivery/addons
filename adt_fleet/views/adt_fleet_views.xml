<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This file will contain the views for the adt_fleet module -->
    <record id="fleet_vehicle_search_inherit_documento" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.inherit.documento</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="driver_id" string="Documento"
                       filter_domain="[('driver_id.vat', 'ilike', self)]"/>
                <field name="vin_sn" string="Chasis"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_model_form_inherit_mototaxi" model="ir.ui.view">
        <field name="name">fleet.vehicle.model.form.inherit.mototaxi</field>
        <field name="model">fleet.vehicle.model</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='information']" position="inside">
                <group string="Información Mototaxi"
                       attrs="{'invisible': [('vehicle_type','!=','mototaxi')]}">

                    <group>
                           <field name="seats"/>
                           <field name="doors"/>
                           <field name="color"/>
                           <field name="model_year"/>
                    </group>

                </group>
            </xpath>

        </field>
    </record>
</odoo>
