<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="adt_dashboard_flota.Dashboard">
        <div class="o_action adt_fd">
            <div class="adt_fd__scroll">
                <header class="adt_fd__header">
                    <div>
                        <h1 class="adt_fd__title">Operación de flota</h1>
                        <p class="adt_fd__subtitle">Stock, placas y salud del flujo desde la factura hasta la entrega</p>
                    </div>
                    <div class="adt_fd__header-actions">
                        <span class="adt_fd__updated" data-ref="updated"/>
                        <button type="button" class="adt_fd__btn" data-action="refresh">Actualizar</button>
                    </div>
                </header>
                <div data-ref="body">
                    <div class="adt_fd__loading">Cargando datos de flota…</div>
                </div>
            </div>
            <div class="adt_fd__tooltip" data-ref="tooltip" role="tooltip"/>
        </div>
    </t>

</templates>
