<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_traccar_device_credential_tree" model="ir.ui.view">
        <field name="name">adt.traccar.device.credential.tree</field>
        <field name="model">adt.traccar.device.credential</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'activo'" decoration-muted="state in ('revocado',)"
                  decoration-danger="state == 'error'">
                <field name="plate"/>
                <field name="imei"/>
                <field name="partner_id"/>
                <field name="email_sequence"/>
                <field name="state" widget="badge"/>
                <field name="gps_status" widget="badge"
                       decoration-success="gps_status == 'online'"
                       decoration-muted="gps_status == 'offline'"
                       decoration-warning="gps_status == 'unknown'"/>
                <field name="gps_last_update"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_traccar_device_credential_form" model="ir.ui.view">
        <field name="name">adt.traccar.device.credential.form</field>
        <field name="model">adt.traccar.device.credential</field>
        <field name="arch" type="xml">
            <form string="Credencial Traccar">
                <header>
                    <button name="action_refresh_gps_status" type="object" string="Actualizar estado GPS"
                            class="btn-primary" attrs="{'invisible': [('state', '!=', 'activo')]}"/>
                    <button name="action_regenerate_password" type="object" string="Regenerar password"
                            class="btn-secondary" attrs="{'invisible': [('state', '!=', 'activo')]}"/>
                    <button name="action_revoke" type="object" string="Revocar"
                            class="btn-secondary" attrs="{'invisible': [('state', '!=', 'activo')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,activo"/>
                </header>
                <sheet>
                    <group>
                        <group string="Vehículo">
                            <field name="vehicle_id"/>
                            <field name="plate"/>
                            <field name="imei"/>
                        </group>
                        <group string="Cliente">
                            <field name="partner_id"/>
                            <field name="cuenta_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Traccar - Dispositivo">
                            <field name="traccar_device_id"/>
                            <field name="traccar_user_id"/>
                        </group>
                        <group string="Traccar - Credenciales de acceso (sensible)">
                            <field name="email_sequence"/>
                            <field name="partner_email_base" groups="adt_traccar_device.group_traccar_credentials_admin"/>
                            <field name="traccar_email" groups="adt_traccar_device.group_traccar_credentials_admin"/>
                            <!-- Un solo campo, ofuscado por defecto, con un botón de "ojo"
                                 integrado para revelarlo/ocultarlo en el mismo lugar
                                 (widget propio, ver static/src/js/password_toggle_field.js). -->
                            <field name="traccar_password" widget="adt_password_toggle"
                                   groups="adt_traccar_device.group_traccar_credentials_admin"/>
                        </group>
                    </group>
                    <group string="Estado GPS (botón «Actualizar estado GPS» arriba)">
                        <group>
                            <field name="gps_status" widget="badge"
                                   decoration-success="gps_status == 'online'"
                                   decoration-muted="gps_status == 'offline'"
                                   decoration-warning="gps_status == 'unknown'"/>
                            <field name="gps_last_update" readonly="1"/>
                            <field name="gps_status_refreshed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="gps_speed_kmh" readonly="1"/>
                            <field name="gps_battery_level" readonly="1"/>
                            <field name="gps_latitude" readonly="1"/>
                            <field name="gps_longitude" readonly="1"/>
                            <field name="gps_address" readonly="1" attrs="{'invisible': [('gps_address', '=', False)]}"/>
                            <field name="gps_maps_url" widget="url" string="Mapa"
                                   attrs="{'invisible': [('gps_maps_url', '=', False)]}"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('last_error', '=', False)]}">
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_traccar_device_credential" model="ir.actions.act_window">
        <field name="name">Credenciales Traccar</field>
        <field name="res_model">adt.traccar.device.credential</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
