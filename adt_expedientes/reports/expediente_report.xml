<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_adt_expediente_compacto" model="report.paperformat">
        <field name="name">Expediente PDF Compacto</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">16</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="True"/>
        <field name="header_spacing">6</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_adt_expediente_pdf" model="ir.actions.report">
        <field name="name">Expediente PDF</field>
        <field name="model">adt.expediente</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adt_expedientes.report_adt_expediente_pdf</field>
        <field name="report_file">adt_expedientes.report_adt_expediente_pdf</field>
        <field name="print_report_name">'Expediente - %s' % (object.cliente_id.name or object.id)</field>
        <field name="paperformat_id" ref="adt_expedientes.paperformat_adt_expediente_compacto"/>
        <field name="binding_model_id" ref="model_adt_expediente"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_adt_expediente_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="margin-top:0; padding-top:4mm;">
                        <style>
                            .page h4 { font-weight: 700; margin: 0 0 2mm 0; page-break-after: avoid; }
                            .page img { margin-bottom: 4mm; page-break-before: avoid; page-break-inside: avoid; }
                            .page .image-block { padding-top: 4mm; page-break-inside: avoid; break-inside: avoid; }
                        </style>
                        <h2 style="margin-top:0; padding-top:0; font-weight:700;">Expediente - Imagenes</h2>

                        <t t-if="doc.foto_dni_frente">
                            <div class="image-block">
                                <h4>DNI - Imagen 1</h4>
                                <img t-att-src="doc.get_data_uri('foto_dni_frente')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_dni_reverso">
                            <div class="image-block">
                                <h4>DNI - Imagen 2</h4>
                                <img t-att-src="doc.get_data_uri('foto_dni_reverso')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_ce_frente">
                            <div class="image-block">
                                <h4>Carnet de Extranjeria - Imagen 1</h4>
                                <img t-att-src="doc.get_data_uri('foto_ce_frente')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_ce_reverso">
                            <div class="image-block">
                                <h4>Carnet de Extranjeria - Imagen 2</h4>
                                <img t-att-src="doc.get_data_uri('foto_ce_reverso')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_pasaporte_frente">
                            <div class="image-block">
                                <h4>Pasaporte - Imagen 1</h4>
                                <img t-att-src="doc.get_data_uri('foto_pasaporte_frente')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_pasaporte_reverso">
                            <div class="image-block">
                                <h4>Pasaporte - Imagen 2</h4>
                                <img t-att-src="doc.get_data_uri('foto_pasaporte_reverso')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_licencia">
                            <div class="image-block">
                                <h4>Licencia</h4>
                                <img t-att-src="doc.get_data_uri('foto_licencia')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_recibo">
                            <div class="image-block">
                                <h4>Recibo</h4>
                                <img t-att-src="doc.get_data_uri('foto_recibo')" style="width:100%; height:240mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_sentinel_1">
                            <div class="image-block">
                                <h4>Sentinel - Imagen 1</h4>
                                <img t-att-src="doc.get_data_uri('foto_sentinel_1')" style="width:100%; height:240mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_sentinel_2">
                            <div class="image-block">
                                <h4>Sentinel - Imagen 2</h4>
                                <img t-att-src="doc.get_data_uri('foto_sentinel_2')" style="width:100%; height:240mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_moto">
                            <div class="image-block">
                                <h4>Foto en la moto</h4>
                                <img t-att-src="doc.get_data_uri('foto_moto')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_soat">
                            <div class="image-block">
                                <h4>SOAT</h4>
                                <img t-att-src="doc.get_data_uri('foto_soat')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_tarjeta_propiedad_frente">
                            <div class="image-block">
                                <h4>Tarjeta de propiedad - Imagen 1</h4>
                                <img t-att-src="doc.get_data_uri('foto_tarjeta_propiedad_frente')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_tarjeta_propiedad_reverso">
                            <div class="image-block">
                                <h4>Tarjeta de propiedad - Imagen 2</h4>
                                <img t-att-src="doc.get_data_uri('foto_tarjeta_propiedad_reverso')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_ubicacion_actual">
                            <div class="image-block">
                                <h4>Ubicacion actual</h4>
                                <img t-att-src="doc.get_data_uri('foto_ubicacion_actual')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_fachada_domicilio">
                            <div class="image-block">
                                <h4>Fachada de domicilio</h4>
                                <img t-att-src="doc.get_data_uri('foto_fachada_domicilio')" style="width:100%; height:130mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>
                        <t t-if="doc.foto_contrato_alquiler">
                            <div class="image-block">
                                <h4>Contrato de alquiler</h4>
                                <img t-att-src="doc.get_data_uri('foto_contrato_alquiler')" style="width:100%; height:240mm; object-fit:contain; display:block;"/>
                            </div>
                        </t>

                        <div style="page-break-before: always;"/>
                        <h2>Expediente - Datos</h2>

                        <table class="table table-sm" style="width:100%; margin-bottom:16px;">
                            <tbody>
                                <tr>
                                    <td><strong>Cliente:</strong></td>
                                    <td><span t-esc="doc.cliente_id.name or ''"/></td>
                                    <td><strong>Asesora:</strong></td>
                                    <td><span t-esc="doc.asesora_id.name or ''"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Documento:</strong></td>
                                    <td><span t-esc="doc.cliente_id.document_number or ''"/></td>
                                    <td><strong>Correo:</strong></td>
                                    <td><span t-esc="doc.cliente_id.email or ''"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Teléfono:</strong></td>
                                    <td><span t-esc="doc.cliente_id.mobile or doc.cliente_id.phone or ''"/></td>
                                    <td><strong>Nacionalidad:</strong></td>
                                    <td><span t-esc="doc.cliente_nationality or ''"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Ocupación:</strong></td>
                                    <td><span t-esc="doc.cliente_occupation or ''"/></td>
                                    <td><strong>Dirección:</strong></td>
                                    <td>
                                        <span t-esc="doc.cliente_id.street or ''"/>
                                        <span t-if="doc.cliente_id.city"> - <t t-esc="doc.cliente_id.city"/></span>
                                        <span t-if="doc.cliente_id.state_id"> - <t t-esc="doc.cliente_id.state_id.name"/></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Vehículo:</strong></td>
                                    <td><span t-esc="dict(doc._fields['vehiculo'].selection).get(doc.vehiculo, doc.vehiculo or '')"/></td>
                                    <td><strong>Fecha:</strong></td>
                                    <td><span t-esc="doc.fecha or ''"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table table-sm" style="width:100%; margin-top:8px;">
                            <tbody>
                                <tr>
                                    <td style="width:25%;"><strong>Ganancia diaria / mensual:</strong></td>
                                    <td style="width:25%;">S/ <span t-esc="doc.ganancia_diaria_mensual or ''"/></td>
                                    <td style="width:25%;"><strong>Tiempo trabajando:</strong></td>
                                    <td style="width:25%;"><span t-esc="doc.tiempo_trabajando or ''"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Empresa asociada:</strong></td>
                                    <td><span t-esc="doc.moto_empresa or ''"/></td>
                                    <td><strong>Moto propia o alquilada:</strong></td>
                                    <td><span t-esc="doc.moto_propiedad or ''"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Tipo de vivienda:</strong></td>
                                    <td><span t-esc="doc.tipo_vivienda or ''"/></td>
                                    <td><strong>Número dueño / contacto:</strong></td>
                                    <td><span t-esc="doc.propietario_contacto or ''"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Tiempo en ese lugar:</strong></td>
                                    <td colspan="3"><span t-esc="doc.tiempo_viviendo or ''"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Referencias</h3>
                        <table class="table table-sm" style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr style="background-color:#f2f2f2;">
                                    <th style="padding:6px; border:1px solid #dee2e6;">#</th>
                                    <th style="padding:6px; border:1px solid #dee2e6;">Nombre</th>
                                    <th style="padding:6px; border:1px solid #dee2e6;">Teléfono</th>
                                    <th style="padding:6px; border:1px solid #dee2e6;">Vinculo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding:6px; border:1px solid #dee2e6;">1</td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_1_name or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_1_phone or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_1_vinculo or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:6px; border:1px solid #dee2e6;">2</td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_2_name or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_2_phone or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_2_vinculo or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:6px; border:1px solid #dee2e6;">3</td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_3_name or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_3_phone or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_3_vinculo or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:6px; border:1px solid #dee2e6;">4</td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_4_name or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_4_phone or ''"/></td>
                                    <td style="padding:6px; border:1px solid #dee2e6;"><span t-esc="doc.ref_4_vinculo or ''"/></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>